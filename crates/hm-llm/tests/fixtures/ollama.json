[
  {
    "request": {
      "method": "POST",
      "url": "http://fixture.invalid/api/chat",
      "headers": {"content-type": "application/json"},
      "body": {
        "model": "fixture-model",
        "messages": [
          {"role": "system", "content": "Decide temporal supersession."},
          {"role": "user", "content": "old: Europe\nnew: America"}
        ],
        "format": {
          "type": "object",
          "properties": {
