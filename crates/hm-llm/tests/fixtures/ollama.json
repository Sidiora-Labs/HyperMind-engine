            "reason": {"type": "string"}
          },
          "required": ["supersedes", "reason"],
          "additionalProperties": false
        },
        "stream": false,
        "options": {"num_predict": 64}
      }
    },
    "response": {
      "status": 200,
      "body": {
        "message": {"content": "{\"supersedes\":true,\"reason\":\"later interval\"}"},
        "prompt_eval_count": 10,
        "eval_count": 4
      }
    }
  }
]
