[
  {
    "request": {
      "method": "POST",
      "url": "https://fixture.invalid/v1/chat/completions",
      "headers": {
        "authorization": "Bearer fixture-key",
        "content-type": "application/json"
      },
      "body": {
        "model": "fixture-model",
        "messages": [
          {"role": "system", "content": "Decide temporal supersession."},
          {"role": "user", "content": "old: Europe\nnew: America"}
        ],
        "max_tokens": 64,
        "response_format": {
          "type": "json_schema",
          "json_schema": {
            "name": "supersession_1",
            "strict": true,
            "schema": {
              "type": "object",
              "properties": {
                "supersedes": {"type": "boolean"},
                "reason": {"type": "string"}
              },
              "required": ["supersedes", "reason"],
              "additionalProperties": false
            }
          }
        }
      }
    },
    "response": {
      "status": 200,
      "body": {
        "choices": [{"message": {"content": "{\"supersedes\":true,\"reason\":\"later interval\"}"}}],
        "usage": {
          "prompt_tokens": 10,
          "completion_tokens": 4,
          "prompt_tokens_details": {"cached_tokens": 2}
        }
      }
    }
  }
]
