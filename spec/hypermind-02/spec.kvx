[task.13.3]
title = "inspect surfaces for sources and their entity contributions"
status = "done"
wave = 13
owner_lane = "surfaces"
requires = []
reqs = ["13.1"]
touches = ["crates/hm-mcp/src/tools/sources.rs", "crates/hm-mcp/src/tools/mod.rs", "crates/hm-mcp/src/tools/inspect.rs", "crates/hm-mcp/tests/inspect_sources.rs"]
verify_cmd = "cargo test -p hm-mcp --test inspect_sources"
do_1 = "Add two read-only targets inside the existing inspect verb so a console can answer 'what is in this source, which entities did it contribute, and what does it share with other sources'. hm://{actor}/sources groups every ledger frame by conversation and reports record counts, first and last LSN, last wall timestamp and a per-event-kind tally. hm://{actor}/sources/{conversation_hex} decodes the UserMsg and DeliveredMsg frames of that one conversation, runs the kernel's own deterministic extractor hm_index::entity_rules::extract_entities over their content, and reports the canonical entities with their kinds, aliases and contributing LSNs, the entities that also appear in other conversations with the conversation hexes that share them, and one hm:// citation per contributing record. The extractor is named in the payload ('extractor': 'entity_rules') so the surface is honest about where the entity set comes from: it is the same function the entity projection indexes with, applied to the same decoded content, not a second heuristic. Both targets are bounded and refuse rather than truncate silently past the frame cap."
do_2 = "Prove it: inspect with uri = 'hm://7/sources' returns ok with one item per conversation carrying surface: 'sources', 32-hex conversation, records, first_lsn, last_lsn, last_wall_timestamp_ns and a kinds object keyed by lowercase event-kind name, sorted by first_lsn ascending, plus one hm://{actor}/lsn/{last_lsn} provenance entry per conversation. No new MCP verb, no dispatcher arm, no change to hm_serve::rest::VERBS, schemas/openapi.yaml or docs/tools/usage.json."

[task.13.4]
title = "Console source and entity explorer view"
status = "done"
wave = 13
owner_lane = "sdk"
requires = ["13.2", "13.3"]
reqs = ["13.3"]
touches = ["sdk/typescript/packages/console/src/sources.ts", "sdk/typescript/packages/console/src/sources.test.ts", "sdk/typescript/packages/console/src/app.ts", "sdk/typescript/packages/console/src/index.ts", "docs/reference/generated/sdk-api.md", "docs/reference/generated/coverage.json"]
verify_cmd = "npm --prefix sdk/typescript run test -w @hypermind/console"
do_1 = "Render the source and entity surfaces in the console. buildSourceIndex turns the hm://{actor}/sources envelope into a list of sources with record counts, LSN range and event-kind tallies; buildSourceDetail turns the hm://{actor}/sources/{conversation} envelope into the entities a source contributed, the entities it shares with other sources, and its citation links. renderSourceIndex and renderSourceDetail emit escaped HTML in which every record is a hm:// citation link and every shared entity names the other conversations by hex, so an operator can move from a source to a record to another source without leaving authoritative data. The view refuses to invent counts: a missing field throws ConsoleDataError rather than defaulting to zero, and the truncated flag from the server is surfaced verbatim as a visible note. src/app.ts gains a sources section that lists sources and expands one on click."
do_2 = "Prove it: buildSourceIndex on a real hm://7/sources envelope returns one entry per conversation with conversation, records, firstLsn, lastLsn, kinds, sorted by firstLsn. The test runs against a real daemon: records written through remember in two conversations appear in the rendered index with the right counts, and a shared entity appears in sharedEntities with both conversation hexes."

[task.13.5]
title = "Carry the retrieval manifest in the activate envelope"
status = "done"
wave = 13
owner_lane = "surfaces"
requires = []
reqs = ["13.2"]
touches = ["crates/hm-mcp/src/lib.rs", "crates/hm-serve/src/rest/mod.rs", "schemas/openapi.yaml", "crates/hm-mcp/tests/activate_manifest.rs"]
verify_cmd = "cargo test -p hm-mcp --test activate_manifest"
do_1 = "Make the difference between retrieved and included evidence observable at the surface. hm_compose::bundle::RetrievalManifest already records candidates, selected, included and used for every activation, but bundle_envelope drops it, so no client can tell a record that was retrieved and trimmed from one that reached the prompt. Add one optional manifest field to hm_mcp::Envelope, default None, skipped when absent so every other verb's bytes are unchanged, and fill it in bundle_envelope with the manifest identity, the snapshot epoch, the encoder, the index generation, the candidate lane names and the four LSN sets, naming candidates as retrieved and keeping selected, included and used under their own names."
do_2 = "Mirror the field on the REST ToolEnvelope schema and in the hand-kept schemas/openapi.yaml so the documented response matches what the daemon sends. Nothing about ranking, trimming or hashing changes."
do_3 = "Prove it: hm_mcp::Envelope has pub manifest: Option<serde_json::Value> with #[serde(skip_serializing_if = 'Option::is_none')], set to None by Envelope::empty(), so the serialized envelope of remember, recall, inspect and every other verb is byte-identical to before. candidate_lanes names come from an exhaustive const fn over hm_compose::bundle::RetrievalLane, so a future lane fails to compile rather than serialising as an unknown string."

[task.13.6]
title = "inspect evidence path edges and reverse answer lookup"
status = "done"
wave = 13
owner_lane = "surfaces"
requires = ["13.3"]
reqs = ["13.1"]
touches = ["crates/hm-mcp/src/tools/evidence.rs", "crates/hm-mcp/src/tools/inspect.rs", "crates/hm-mcp/src/tools/mod.rs", "crates/hm-mcp/tests/inspect_evidence.rs"]
verify_cmd = "cargo test -p hm-mcp --test inspect_evidence"
do_1 = "Make the inspect reference walk navigable and add the reverse direction. The existing walk from hm://{actor}/lsn/{n} discovers supporting records but reports them as a flat item list, losing which record supported which and by what field. Change the private references helper to return the referenced LSN together with the payload field that named it, and record every hop as an edge; publish them as items[0].evidence_path = {label: 'evidence_path', root_lsn, edges: [{from, to, relation}], visited}. Add the reverse target hm://{actor}/evidence/{lsn}, which scans the ledger for Attestation frames whose target_lsn is that record and reports the four disposition counters together with the attesting records themselves — attestation LSN, conversation hex and disposition — so a console can answer 'which answers used this record'. Counters are derived from the ledger scan and the payload says so ('counts_from': 'ledger_scan'), because the ledger is the authority and the attestations projection is not reachable from this surface."
do_2 = "Prove it: inspect with uri = 'hm://7/lsn/{n}' returns, in addition to the existing per-record items, items[0]['evidence_path'] with label == 'evidence_path', root_lsn == n, visited equal to the number of distinct records walked, and one edges entry per hop carrying from, to and a relation from the fixed set tool_call_lsn | evidence_lsns | evidence_lsn | target_lsn | observation_lsns. The existing inspect behaviour for hm://{actor}/attention, hm://{actor}/calibration and the plain no-uri call is unchanged, and cargo test -p hm-mcp --test tools still passes."

[task.13.7]
title = "Console evidence-path navigation and reverse answer lookup"
status = "done"
wave = 13
owner_lane = "sdk"
requires = ["13.2", "13.5", "13.6"]
reqs = ["13.2", "13.3"]
touches = ["sdk/typescript/packages/console/src/evidence.ts", "sdk/typescript/packages/console/src/evidence.test.ts", "sdk/typescript/packages/console/src/app.ts", "sdk/typescript/packages/console/src/index.ts", "docs/reference/generated/sdk-api.md", "docs/reference/generated/coverage.json"]
verify_cmd = "npm --prefix sdk/typescript run test -w @hypermind/console"
do_1 = "Turn the evidence surfaces into a navigable view that never overstates what the engine did. buildEvidencePath takes an inspect envelope for one record and orders its evidence_path edges into a walkable sequence starting at the root, breadth first over the edges the server reported, appending any walked record that no edge reached so nothing the walk visited disappears from the view. Each step carries the record LSN, its kind, its authority, its integrity receipt and the relation that led to it. classifyEvidence joins an activate manifest and an hm://{actor}/evidence/{lsn} envelope into per-record flags retrieved, included and attested, which are three separate booleans and are rendered as three separate labels. buildAnswerLookup lists the attesting records that used a given record. renderEvidencePath labels the section 'Evidence path' and never uses the words reasoning, trace or thought; renderAnswerLookup links each answer to its own hm:// record."
do_2 = "Prove it: buildEvidencePath returns steps ordered from the root, each with lsn, kind, authority, relation (undefined for the root) and integrity.leafHash; a record present in the walk but reached by no edge appears as a trailing step rather than being dropped. A real-daemon test shows a record that is retrieved and included but not attested, and the same record attested after an attest call, with retrieved and included unchanged."

[task.13.8]
title = "inspect access surface reporting server-authoritative permissions"
status = "done"
wave = 13
owner_lane = "surfaces"
requires = ["13.6"]
reqs = ["13.1"]
touches = ["crates/hm-serve/src/uds.rs", "crates/hm-serve/src/auth.rs", "crates/hm-mcp/src/tools/access.rs", "crates/hm-mcp/src/tools/mod.rs", "crates/hm-mcp/src/tools/inspect.rs", "crates/hm-mcp/src/lib.rs", "crates/hm-mcp/tests/inspect_access.rs"]
verify_cmd = "cargo test -p hm-mcp --test inspect_access"
do_1 = "Publish the permission facts the daemon actually enforces so a console never guesses them. Add hm://{actor}/access to inspect, returning the actor this connection is bound to, the fact that actors are hard-isolated, whether an admin capability token is configured for this server instance, the admin-only operation names, and one row per MCP verb saying whether it mutates and whether any of its actions additionally require the admin capability. The mutation classification must come from the daemon's own table rather than a copy: extract the verb list inside uds::mutation_request into a new public hm_serve::uds::mutation_verb(verb: &str) -> bool and have mutation_request call it, and add hm_serve::auth::ADMIN_OPERATIONS naming the request kinds is_admin_request accepts."
do_2 = "Also report the protected belief types, whose direct writes by a consolidation run are rejected. Every value in the item is computed on the server and the item carries 'source': 'server' so the console can assert it did not invent anything."
do_3 = "Prove it: inspect with uri = 'hm://7/access' returns one item with surface: 'access', actor: 7, isolation: 'actor_scoped', source: 'server', admin_token_configured, admin_operations, verbs and protected_belief_types. mutation_request in crates/hm-serve/src/uds.rs behaves exactly as before after the extraction; cargo test -p hm-serve --test uds still passes."

[task.13.9]
title = "Console governance and access overlay view"
status = "done"
wave = 13
owner_lane = "sdk"
requires = ["13.2", "13.8"]
reqs = ["13.3"]
touches = ["sdk/typescript/packages/console/src/access.ts", "sdk/typescript/packages/console/src/access.test.ts", "sdk/typescript/packages/console/src/app.ts", "sdk/typescript/packages/console/src/index.ts", "docs/reference/generated/sdk-api.md", "docs/reference/generated/coverage.json"]
verify_cmd = "npm --prefix sdk/typescript run test -w @hypermind/console"
do_1 = "Render who can read and write what, using only the server's answer. buildAccessView parses the hm://{actor}/access envelope into the bound actor, the isolation statement, whether an admin capability is configured, the admin-only operations, the per-verb read and write rows, and the protected belief types. It asserts the item's source field is server and throws ConsoleDataError otherwise, so a console can never fall back to a locally guessed permission table. renderAccess renders one row per verb with an explicit read or write label and a separate column for actions that additionally need the admin capability, and renders the protected belief types with the reason they are protected: a consolidation run's direct write to them is rejected and surfaces as a proposal. src/app.ts gains a governance section that loads once and refuses to render a partial table."
do_2 = "Prove it: buildAccessView returns {actor, isolation, adminTokenConfigured, adminOperations, verbs, protectedBeliefTypes} from a real access envelope, with verbs entries {verb, mutating, adminTokenRequiredActions}. A real-daemon test asserts the rendered table has one row per verb reported by the server and that the row set matches the server's verbs array exactly."

[task.13.10]
title = "inspect removal-preview diagnostic over the evidence reference graph"
status = "done"
wave = 13
owner_lane = "surfaces"
requires = ["13.8"]
reqs = ["13.1"]
touches = ["crates/hm-mcp/src/tools/removal.rs", "crates/hm-mcp/src/tools/mod.rs", "crates/hm-mcp/src/tools/inspect.rs", "crates/hm-mcp/tests/inspect_removal.rs"]
verify_cmd = "cargo test -p hm-mcp --test inspect_removal"
do_1 = "Answer 'what changes if this record disappears' before anyone retracts anything, as a diagnostic that writes nothing. Add hm://{actor}/removal/{lsn} to inspect. Build the undirected evidence reference graph over the ledger from the same relation set the evidence path uses: for every frame, the LSNs its payload names through tool_call_lsn, evidence_lsns, evidence_lsn, target_lsn or observation_lsns."
do_2 = "Walk the target's connected component; if it is smaller than three records nothing can be stranded and the preview is empty. Otherwise drop the target's own edges, recompute the component's fragments, treat the largest fragment as the graph still standing, and report every smaller fragment as orphaned; when the largest fragment is itself a single record, the target was a hub of leaves and every fragment counts as orphaned. Report the target's direct dependents, the orphaned LSNs, the island count, the attestation counters on the target and how many frames were scanned."
do_3 = "The item is labelled 'diagnostic': 'removal_preview' with 'performs_retraction': false; the surface appends no event and takes no lock."
do_4 = "Prove it: inspect with uri = 'hm://7/removal/{lsn}' returns one item with diagnostic: 'removal_preview', performs_retraction: false, target_lsn, direct_dependents, orphaned_lsns, island_count, attestation_counts and scanned_frames. All lists are sorted ascending so two calls on an unchanged ledger produce byte-identical items."

[task.13.11]
title = "Console removal-preview diagnostics view"
status = "done"
wave = 13
owner_lane = "sdk"
requires = ["13.2", "13.10"]
reqs = ["13.3"]
touches = ["sdk/typescript/packages/console/src/removal.ts", "sdk/typescript/packages/console/src/removal.test.ts", "sdk/typescript/packages/console/src/app.ts", "sdk/typescript/packages/console/src/index.ts", "docs/reference/generated/sdk-api.md", "docs/reference/generated/coverage.json"]
verify_cmd = "npm --prefix sdk/typescript run test -w @hypermind/console"
do_1 = "Render the removal preview so it can never be mistaken for a retraction. buildRemovalPreview parses the hm://{actor}/removal/{lsn} envelope into the target record, its direct dependents, the orphaned records, the island count, the attestation counters and the number of frames scanned, and asserts the item's diagnostic field is removal_preview and performs_retraction is false, throwing ConsoleDataError otherwise. renderRemovalPreview heads the section with the word Diagnostic, states in plain words that nothing has been removed, links every orphaned record to its hm:// URI, and reports the scanned-frame bound so an operator can see the preview's scope. src/app.ts gains a per-record preview action that only ever calls inspect."
do_2 = "Prove it: buildRemovalPreview returns {targetLsn, directDependents, orphanedLsns, islandCount, attestationCounts, scannedFrames, performsRetraction: false} from a real envelope. The real-daemon test reproduces the two-dependent fixture and asserts islandCount === 2 and two orphaned records, then asserts the daemon's applied_lsn is unchanged after rendering the preview."

[task.13.12]
title = "Console domain-profile editor with explicit versions"
status = "done"
wave = 13
owner_lane = "sdk"
requires = ["13.2"]
reqs = ["13.5"]
touches = ["sdk/typescript/packages/console/src/domain-profile.ts", "sdk/typescript/packages/console/src/domain-profile.test.ts", "sdk/typescript/packages/console/package.json", "sdk/typescript/packages/console/src/app.ts", "sdk/typescript/packages/console/src/index.ts", "docs/reference/generated/sdk-api.md", "docs/reference/generated/coverage.json"]
verify_cmd = "npm --prefix sdk/typescript run test -w @hypermind/console"
do_1 = "Let an operator describe the entity types, fields and relationships their domain cares about, without touching an internal event schema. The domain profile is a console document with the explicit schema string hypermind.domain-profile.v1 and an integer version; applyDomainAction is a pure reducer over add, rename, delete and duplicate for types and fields, plus add and delete for relationships, and every action that changes content increments version, so a profile can never drift without its version moving. compileDomainProfile validates the profile and produces a canonical JSON document with sorted keys plus a sha256 digest, rejecting duplicate type names, duplicate field names within a type, relationship targets that are not declared types, reserved field names that collide with record metadata (lsn, authority, provenance, conversation), and empty names. persistDomainProfile stores the compiled document through the existing remember verb as a user-asserted document in the console-domain-profile conversation and refuses to store a profile with validation errors; loadDomainProfile reads the latest stored profile back through recall in timeline mode. The profile changes how the console groups and labels the entities the server already extracted; it does not change server-side extraction, which stays deterministic in the kernel, and the module and the guide say so."
do_2 = "Prove it: emptyDomainProfile() returns {schema: 'hypermind.domain-profile.v1', version: 1, types: []}. The module exports no mutation path other than persistDomainProfile, and nothing in it references an event kind, a FlatBuffers type or a schema file."

[task.13.13]
title = "Console resumable upload sessions with honest degraded reporting"
status = "done"
wave = 13
owner_lane = "sdk"
requires = ["13.2"]
reqs = ["13.5"]
touches = ["sdk/typescript/packages/console/src/upload-session.ts", "sdk/typescript/packages/console/src/test/file-store.ts", "sdk/typescript/packages/console/src/upload-session.test.ts", "sdk/typescript/packages/console/src/app.ts", "sdk/typescript/packages/console/src/index.ts", "docs/reference/generated/sdk-api.md", "docs/reference/generated/coverage.json"]
verify_cmd = "npm --prefix sdk/typescript run test -w @hypermind/console"
do_1 = "Make a multi-document ingestion survive a reload and never claim to have finished when it has not. An upload session is a versioned document (hypermind.console-upload-session.v1) recording the conversation, the total document count and bytes, the batches the daemon has already accepted with their LSN ranges, the documents still to send, the stage, and two separate honesty flags: degraded means the session was written but its pending payloads were not, and persisted false means nothing reached storage at all and this session will not survive a reload. saveSession writes the whole record, retries metadata-only when the full write fails, and reports which of the two happened rather than returning something that looks durable. updateSession writes only when the record still exists, returning null instead of resurrecting a session another tab deleted. resumeUpload sends the remaining documents through the existing remember verb, recording each accepted batch's real first_lsn and last_lsn. uploadStatus returns complete only when every document is accounted for by an accepted batch and the session is not degraded, so an incomplete upload can never be reported as finished. Two real stores are provided: a Node filesystem store used by the tests, and a Web Storage store for the browser."
do_2 = "Prove it: saveSession on a writable store returns the session with persisted: true and degraded: false; on a store whose full write fails but whose metadata write succeeds it returns pending: [], degraded: true, persisted: true; on a store where both fail it returns pending: [], degraded: true, persisted: false. The degraded path is exercised by a real filesystem failure (a store rooted at a directory made unwritable), not by an injected fake."

[task.13.14]
title = "Console live activity feed with actor-scoped cursor recovery"
status = "done"
wave = 13
owner_lane = "sdk"
requires = ["13.2"]
reqs = ["13.5"]
touches = ["sdk/typescript/packages/console/src/activity.ts", "sdk/typescript/packages/console/src/node-transport.ts", "sdk/typescript/packages/console/src/activity.test.ts", "sdk/typescript/packages/console/src/app.ts", "sdk/typescript/packages/console/src/index.ts", "docs/reference/generated/sdk-api.md", "docs/reference/generated/coverage.json"]
verify_cmd = "npm --prefix sdk/typescript run test -w @hypermind/console"
do_1 = "Show ingestion, recall and consolidation progress as it happens, over the daemon's real subscription, without ever replaying another actor's cursor. The activity feed holds an actor key and a since-LSN cursor; subscribeActivity streams committed events from @hypermind/client's Client.subscribe with that cursor, classifies each event's kind into an ingestion, recall, consolidation or other lane using a declared table derived from the ledger's EventKind discriminants, deduplicates by LSN, keeps at most MAXIMUM_ACTIVITY_EVENTS entries and advances the cursor to the highest LSN seen. switchActor drops the cursor to zero and clears both the event list and the seen set, so switching actors can never ask the new actor's log for events since a position that means nothing there. recordSubscribeFailure classifies a rejected subscription: a capacity or sequence rejection means the cursor is no longer usable and resets it to zero once, anything else is a retry, and the feed reports which happened rather than silently looping on a rejected cursor. renderActivity groups the entries by lane with their LSNs and timestamps."
do_2 = "Prove it: createActivityFeed({actorKey: '7'}) starts with cursor === 0n and no events; after streaming three real remember events the cursor equals the highest LSN seen and the feed holds three entries with ascending LSNs, each classified ingestion. The classification table is exported and every lane assignment in it is justified by the EventKind discriminant it names; the real-daemon test proves the remember and attest assignments end to end rather than asserting the table against itself."

[task.13.15]
title = "Console guide and SDK reference, and the group's docs gate"
status = "done"
wave = 13
owner_lane = "docs"
requires = ["13.4", "13.7", "13.9", "13.11", "13.12", "13.13", "13.14"]
reqs = ["13.3", "13.4"]
touches = ["docs/guides/console.md", "docs/SUMMARY.md", "docs/reference/sdks.md", "docs/reference/cli.md", "docs/reference/generated/sdk-api.md", "docs/reference/generated/cli-declarations.md", "docs/reference/generated/coverage.json"]
verify_cmd = "cargo run --locked -p hm-eval -- docs-gate"
do_1 = "Close the group with the prose an operator needs and a green docs gate. Add docs/guides/console.md describing what the console is, how to build it (npm --prefix sdk/typescript run build -w @hypermind/console), how to serve it (hm serve --rest-bind ... --console-directory sdk/typescript/packages/console/dist/site), what each view shows, and the boundaries this group deliberately kept: every view renders authoritative server data; permissions come from the access surface and are never computed locally; the evidence path is a record reference walk and is not a model's reasoning; retrieved, included and attested are three different facts; removal previews are diagnostics that write nothing; the domain profile configures console presentation and never an internal event schema; upload sessions report degraded storage rather than claiming completion."
do_2 = "State plainly that the REST listener requires mutual TLS, so a browser must present a client certificate, and that no browser rendering is covered by any test in this repository. Link the page from docs/SUMMARY.md, add the console package to the SDK reference page, and regenerate the catalogs so docs-gate is green."
do_3 = "Prove it: docs/guides/console.md exists, covers build, serve, each of the seven views, and the seven boundary statements above, and names the mutual-TLS limitation explicitly. Every local link and anchor added by this task resolves, as enforced by the catalog's link checker."

[task.14.1]
title = "Long-context probe-set adapter and in-repo probe fixture"
status = "done"
wave = 14
section = "Wave 14 - Probe benchmarking and the cross-SDK behavioural contract"
owner_lane = "eval-benchmarks"
requires = []
reqs = ["14.1"]
touches = ["crates/hm-eval/src/bench/beam.rs", "crates/hm-eval/src/bench/mod.rs", "eval/fixtures/beam/probe-set.json", "crates/hm-eval/tests/beam.rs", "eval/datasets/README.md", "docs/reference/generated/rust-types.md", "docs/reference/generated/coverage.json"]
verify_cmd = "cargo test -p hm-eval --locked --test beam"
do_1 = "Add crates/hm-eval/src/bench/beam.rs, a dataset adapter that turns a published long-context memory benchmark artifact into HyperMind's own normalized probe set and validates it. Define ProbeSet, Conversation, Session, Message, Probe and ProbeKind (the ten published skill categories: information_extraction, temporal_reasoning, multi_session_reasoning, contradiction_resolution, event_ordering, knowledge_update, summarization, abstention, preference_following, instruction_following), reusing crate::bench::pipeline::BenchRole for message roles rather than adding a role type. parse_probe_set enforces the format tag, unique conversation ids, probe ids unique across the whole set, message ids unique within a conversation, non-empty question, reference answer and criteria, every evidence_message_ids entry resolving to a real message in that conversation, and the rule that an abstention probe carries no evidence ids while every other kind carries at least one. adapt_published_artifact reads the operator-supplied artifact from eval/datasets/beam/ (rows carrying a conversation id, a nested array of session message arrays, and a probing-question map keyed by skill category whose entries may spell the reference answer in several ways and whose probing map may itself arrive as an embedded JSON string), normalizes it, and records the artifact's blake3 digest in ProbeSet.source_digest. to_documents and to_question bridge a conversation into the existing BenchDocument/BenchQuestion shapes so the probe set feeds the real ledger-backed benchmark pipeline. Author a small deterministic in-repo fixture at eval/fixtures/beam/probe-set.json (two conversations, three sessions each, twenty messages each, twelve probes covering all ten kinds) whose content is original HyperMind test material about a fictional project, not benchmark data, so the fixture never claims a benchmark score."
do_2 = "Prove it: beam::fixture_probe_set() parses eval/fixtures/beam/probe-set.json and returns exactly 2 conversations, 40 messages and 12 probes, with every one of the ten ProbeKind values present at least once. MemoryPipeline::open accepts the documents produced by to_documents and MemoryPipeline::retrieve_context(to_question(probe)) returns at least one citation whose document_ids contain a document id derived from that probe's evidence_message_ids, for at least ten of the twelve fixture probes."

[task.14.2]
title = "Criterion-level grading artifacts that preserve criterion, evidence and judge failures"
status = "done"
wave = 14
owner_lane = "eval-benchmarks"
requires = ["14.1"]
reqs = ["14.2"]
touches = ["crates/hm-eval/src/bench/rubric.rs", "prompts/criterion-grade@1.md", "crates/hm-eval/src/bench/mod.rs", "crates/hm-eval/tests/rubric.rs", "docs/reference/generated/prompts.md", "docs/reference/generated/rust-types.md", "docs/reference/generated/coverage.json"]
verify_cmd = "cargo test -p hm-eval --locked --test rubric"
do_1 = "Add crates/hm-eval/src/bench/rubric.rs and the versioned prompt prompts/criterion-grade@1.md. A probe is graded one criterion at a time: for each criterion the judge is asked, through Gateway::complete_with_settings with JUDGE_MODEL and JUDGE_SETTINGS, whether the answer complies, and must return a single JSON object {'compliance': 'full'|'partial'|'none', 'evidence': '...'} where evidence quotes the span of the answer that decides it. parse_verdict accepts a bare object or one inside a fenced block, requires the compliance value to be one of the three literals (no numeric coercion, no score bucketing) and requires non-empty evidence; anything else is a typed VerdictFailure. The resulting CriterionGrade keeps the criterion text byte-for-byte at its original index, the judge's evidence verbatim, the blake3 digest of the raw judge response, the judge model id and the prompt id, so every grade can be re-read back to the exact criterion and the exact evidence that produced it."
do_2 = "The central honesty rule is that a judge failure is not a wrong answer: a criterion whose verdict could not be parsed sets failure, leaves compliance as None, is excluded from the probe mean and counted in judge_failures; a probe with any judge failure has score: None and is reported as unscored rather than scored zero, and summarize reports scored_probes, unscored_probes and judge_failures beside mean_score. A pure seam grade_from_responses turns already-collected raw judge responses into a ProbeGrade so the whole grading and aggregation path is exercised by tests without a provider, while grade_probe is the thin gateway-backed wrapper that collects those responses."
do_3 = "Prove it: rubric::parse_verdict returns Ok((Compliance::None, evidence)) for a well-formed verdict whose compliance is none, and returns Err(VerdictFailure::...) for an empty response, prose with no JSON object, a compliance value outside the three literals, a numeric compliance value, and a well-formed object with empty evidence. CRITERION_PROMPT_ID is 'criterion-grade@1' and CRITERION_PROMPT is bound by include_str! to prompts/criterion-grade@1.md, which names the three compliance levels and requires the evidence field."

[task.14.3]
title = "Deterministic ordering metric wired into ordering-probe grading"
status = "done"
wave = 14
owner_lane = "eval-benchmarks"
requires = ["14.2"]
reqs = ["14.3"]
touches = ["crates/hm-eval/src/bench/ordering.rs", "crates/hm-eval/src/bench/mod.rs", "crates/hm-eval/src/bench/rubric.rs", "crates/hm-eval/tests/ordering.rs", "docs/reference/generated/rust-types.md", "docs/reference/generated/coverage.json"]
verify_cmd = "cargo test -p hm-eval --locked --test ordering"
do_1 = "Add crates/hm-eval/src/bench/ordering.rs, a judge-free metric for probes that ask for events in order. rank_correlation is a pure tie-corrected rank correlation over two integer rank vectors, returning a value in [-1, 1] and 0.0 when fewer than two comparable pairs exist. align_by_terms is the deterministic aligner that replaces an LLM alignment step: it lowercases and strips non-alphanumeric edges from whitespace-separated words, computes set overlap between each observed event and each reference event, and greedily maps each observed event in order to the unused reference event with the highest overlap at or above DEFAULT_MINIMUM_OVERLAP, breaking ties by lowest reference index, leaving unmatched observed events as None. score_ordering builds rank vectors over the union of matched reference positions and unmatched observed positions, combines the normalized correlation with the coverage F1 of matched events, and returns an OrderingScore carrying every intermediate number so a low score can be read as wrong order, missing events or both. split_ordered_answer turns a free-text answer into an ordered event list by numbered lines, then bulleted lines, then sentence order. Wire the metric into grading: rubric::grade_from_responses routes ProbeKind::EventOrdering through score_ordering, using the probe's criteria as the ordered reference list and split_ordered_answer(answer) as the observed list, producing a ProbeGrade with an empty grades list, a new ordering: Option<OrderingScore> field, judge_failures == 0 and a score that never required a judge. Extend GradeSummary with ordering_probes, mean_ordering_score and judge_scored_probes so the judged report states plainly which probes were scored without a judge."
do_2 = "Prove it: ordering::rank_correlation returns 1.0 for two identical strictly increasing vectors, -1.0 for exactly reversed vectors, 0.0 for vectors shorter than two elements or of unequal length, and a value strictly between -1.0 and 1.0 when one pair is tied on one side only. rubric::summarize reports ordering_probes and judge_scored_probes that sum to scored_probes, and a mean_ordering_score computed over ordering probes only."

[task.14.4]
title = "Probe-set benchmark run with separated judge-free and judged reporting"
status = "done"
wave = 14
owner_lane = "eval-benchmarks"
requires = ["14.3"]
reqs = ["14.1", "14.2"]
touches = ["crates/hm-eval/src/bench/beam_run.rs", "crates/hm-eval/src/bench/mod.rs", "crates/hm-eval/src/bench/execution.rs", "crates/hm-eval/src/main.rs", "crates/hm-eval/tests/beam_run.rs", "docs/evaluation/methodology.md", "docs/reference/generated/rust-types.md", "docs/reference/generated/coverage.json"]
verify_cmd = "cargo test -p hm-eval --locked --test beam_run"
do_1 = "Add crates/hm-eval/src/bench/beam_run.rs, the execution path that turns a probe set into a report, and expose it as hm-eval bench beam and hm-eval adapt beam. run_judge_free opens one real MemoryPipeline per conversation over beam::to_documents, calls retrieve_context for every probe, and computes retrieval-side numbers that need no provider at all: evidence recall at the retrieval limit, the rank of the first evidence citation, retrieved context characters, and per-kind probe counts. run adds the answer and grading passes on top: it calls MemoryPipeline::answer with the shared Gateway for the reader, grades each probe through rubric::grade_probe (which routes ordering probes through the judge-free ordering metric), and fills the judged block with a GradeSummary. Reporting is honest by construction: encoder is always 'lexical_only' because no embedding runtime is configured, judge_free is always present, judged is None when no gateway pass ran, and a run over the in-repo fixture sets complete: false with a failure string that says the probe set is the in-repo fixture and not a published benchmark artifact, so a fixture run can never be read as a benchmark score. adapt beam converts the operator-supplied artifact into the normalized probe set on disk; bench beam runs the full pass and writes eval/results/slice7-beam.json through gateway::write_json."
do_2 = "Prove it: beam_run::run_judge_free(&beam::fixture_probe_set()?, tempdir) returns a BeamResult with conversations == 2, total == 12, judged.is_none(), encoder == 'lexical_only', complete == false, and a failure string containing the word fixture. hm-eval bench beam is accepted by main.rs and routes into execution::benchmark('beam', live); hm-eval adapt beam is accepted and writes the normalized probe set; the usage string printed on an unrecognized invocation lists bench <longmemeval|locomo|beam> and adapt beam."

[task.14.5]
title = "Single-variable retrieval sweep with an identity-bound cache"
status = "done"
wave = 14
owner_lane = "eval-benchmarks"
requires = ["14.4"]
reqs = ["14.4"]
touches = ["crates/hm-eval/src/bench/sweep.rs", "crates/hm-eval/src/bench/mod.rs", "crates/hm-eval/src/bench/execution.rs", "crates/hm-eval/src/main.rs", "crates/hm-eval/tests/sweep.rs", "docs/evaluation/methodology.md", "docs/reference/generated/rust-types.md", "docs/reference/generated/coverage.json"]
verify_cmd = "cargo test -p hm-eval --locked --test sweep"
do_1 = "Add crates/hm-eval/src/bench/sweep.rs, a controlled comparison that answers whether one retrieval change helps, and expose it as hm-eval sweep retrieval. A RetrievalVariant names exactly four knobs over the real lexical lane: lexical_limit, minimum_term_overlap, session_cap and recency_weight. validate_single_variable refuses any variant that differs from the baseline in more than one field, refuses duplicate or empty variant names, and refuses a variant named like the baseline, so a sweep can never attribute a delta to a change it did not isolate. run ingests each probe-set conversation into its own real ActorEngine (one IncomingEvent per message in order, so message N is LSN N and the evidence map is exact), then for every variant and every probe issues RecallRequest::Lexical at the variant's limit and applies the remaining three knobs as deterministic post-filters over the returned RecallItems. The metric is judge-free on purpose: evidence recall and mean reciprocal rank of the first evidence hit, so a retrieval regression is never confused with a reader or judge problem."
do_2 = "Every variant's results are cached under a directory whose name is the variant identity — a blake3 over the format tag, the probe-set digest, the full variant record and an include_str! digest of this module — and a cache read re-derives that identity and hard-errors on a mismatch rather than reusing a foreign result. The report names which variants improved and which regressed against the baseline, field by field, and is written to eval/results/retrieval-sweep.json."
do_3 = "Prove it: sweep::validate_single_variable returns Ok for variants differing from the baseline in exactly one field, and Err naming the offending variant for: a variant differing in two fields, a variant identical to the baseline, two variants sharing a name, an empty name, and a variant named baseline. hm-eval sweep retrieval is accepted by main.rs, writes eval/results/retrieval-sweep.json, opens no gateway and makes no network call."

[task.14.6]
title = "Cross-SDK behavioural contract: scenario, observation normalization, comparer and reference leg"
status = "done"
wave = 14
owner_lane = "eval-crosssdk"
requires = []
reqs = ["14.5"]
touches = ["crates/hm-eval/src/contract/mod.rs", "crates/hm-eval/src/lib.rs", "crates/hm-eval/tests/contract.rs", "docs/reference/generated/rust-types.md", "docs/reference/generated/coverage.json"]
verify_cmd = "cargo test -p hm-eval --locked --test contract"
do_1 = "Add crates/hm-eval/src/contract/mod.rs and declare pub mod contract; in crates/hm-eval/src/lib.rs. This task defines the behavioural contract itself: a fixed scenario of MCP verb calls, expressed only in the fourteen frozen verbs, that exercises identifiers, provenance, rejected arguments, rejected mutations with effect_state, deletion and restart. scenario(conversation) returns the ordered ScenarioCall list, each tagged Phase::BeforeRestart or Phase::AfterRestart. observe normalizes one envelope into a StepObservation that keeps only behaviour: whether the call succeeded, the error code, the effect_state, the item identifiers drawn in order from first_lsn, last_lsn, lsn, belief_id, run_id and receipt, the normalized provenance URIs, the authority class of every item, the health keys and values, the gap kinds and the warning prefixes. normalize_provenance keeps scheme, actor, conversation, lsn, src and score and drops the clock-bound at query field so two SDKs can be compared without comparing wall time. compare takes the observations of every participating SDK plus the recorded unavailable and unsupported entries and returns a ContractComparison listing, per step and per field, every value that differs. The reference leg runs the same scenario in-process against a real ActorEngine through hm_mcp::McpServer, shutting down and reopening the engine between the two phases so the restart leg is a real replay, and is the observation every wire SDK is compared against."
do_2 = "Prove it: contract::scenario('contract-a') returns at least eight steps whose verbs are all members of the fourteen-verb inventory, covering at minimum: two remember calls, a recall, a rejected recall argument, a rejected remember mutation, an inspect of an hm:// URI, a forget fade, and a post-restart recall. contract::observe_raw parses a raw leg document and produces the same ContractObservation shape as the reference leg for the same envelopes."

[task.14.7]
title = "TypeScript contract leg against the real daemon with a crash restart"
status = "done"
wave = 14
owner_lane = "eval-crosssdk"
requires = ["14.6"]
reqs = ["14.5"]
touches = ["crates/hm-eval/src/contract/daemon.rs", "crates/hm-eval/src/contract/typescript.rs", "crates/hm-eval/src/contract/mod.rs", "eval/contract/typescript-leg.mjs", "eval/contract/scenario.v1.json", "crates/hm-eval/tests/contract_typescript.rs", "docs/reference/generated/rust-types.md", "docs/reference/generated/coverage.json"]
verify_cmd = "cargo test -p hm-eval --locked --test contract_typescript"
do_1 = "Add the daemon driver and the TypeScript leg so the contract is proved across a process boundary. crates/hm-eval/src/contract/daemon.rs writes a mode-0600 hypermind.conf with the fixed identities used everywhere else in this repository (user 11 repeated sixteen times, kek 22 repeated thirty-two times, admin token 33 repeated thirty-two times, actor 7 with token 44 repeated thirty-two times, projection_map_bytes=67108864), spawns hm serve --config, polls the socket until it accepts a connection within fifteen seconds, and exposes restart as a real SIGKILL of the child followed by a fresh spawn on the same data directory, so the post-restart phase exercises ledger replay rather than a graceful shutdown. eval/contract/typescript-leg.mjs connects with Client.connect({ socketPath, capabilityToken, connectionId }), runs every scenario step of the requested phase through client.callTool(verb, arguments), records the returned envelope verbatim, records a transport failure as an envelope carrying the thrown error's effect state, and writes the raw leg document to the path given by --out. crates/hm-eval/src/contract/typescript.rs reports availability (node present, sdk/typescript/packages/client/dist/index.js present, hm binary present), builds the client workspace once when the compiled output is missing, spawns the leg per phase, and returns a ContractObservation through contract::observe_raw. The test drives the whole thing end to end against the reference leg."
do_2 = "Prove it: contract::daemon::ContractDaemon::start produces a running daemon whose socket accepts a connection, and restart kills the child with SIGKILL, waits for it, and brings a new child up on the same data directory within the same deadline. The comparison's participants lists both rust-embedded and typescript."

[task.14.8]
title = "Python contract leg, honest availability reporting, and the contract report command"
status = "done"
wave = 14
owner_lane = "eval-crosssdk"
requires = ["14.7"]
reqs = ["14.5"]
touches = ["crates/hm-eval/src/contract/python.rs", "crates/hm-eval/src/contract/report.rs", "crates/hm-eval/src/contract/mod.rs", "eval/contract/python-leg.py", "crates/hm-eval/src/main.rs", "crates/hm-eval/tests/contract_report.rs", "docs/evaluation/methodology.md", "docs/reference/generated/rust-types.md", "docs/reference/generated/coverage.json"]
verify_cmd = "cargo test -p hm-eval --locked --test contract_report"
do_1 = "Complete the cross-SDK contract with the Python leg and the operator entry point. eval/contract/python-leg.py reads eval/contract/scenario.v1.json, opens hypermind.Client over gRPC with mutual TLS against the running daemon, runs the requested phase's steps through the shared tool surface, and writes the same raw leg document the TypeScript leg writes. crates/hm-eval/src/contract/python.rs probes availability by importing the SDK in a subprocess and reports a precise reason when the import fails, so a missing dependency is recorded rather than hidden. crates/hm-eval/src/contract/report.rs runs every leg the machine can run — always the in-process reference leg, the TypeScript leg and the Python leg when available — and records every leg it cannot run as an Unavailable entry with its reason, including the Go SDK, whose toolchain is absent here and which is therefore declared unavailable by inspection rather than attempted. The migration step is declared Unsupported for any SDK that does not expose a migration surface, so it is reported as unsupported rather than counted as a divergence. hm-eval contract writes eval/results/cross-sdk-contract.json and exits non-zero when fewer than two legs participated or when the participating legs diverged."
do_2 = "Prove it: contract::python::availability() returns Ok(()) only when a subprocess python3 -c 'import hypermind' succeeds, and otherwise returns an Unavailable whose reason contains the interpreter's own import error text. hm-eval contract is accepted by main.rs, writes eval/results/cross-sdk-contract.json through gateway::write_json, prints the report as one JSON line, and extends the usage string."
