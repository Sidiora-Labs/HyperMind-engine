# hypermind-02: capabilities adopted onto the HyperMind memory engine.
# Recorded after the build-out. KVX Dialect B. Generated Markdown mirrors are views.
# spec/hypermind-01/spec.kvx remains the engine contract; this file extends it without relaxing it.

[meta]
feature = "hypermind-02"
title = "HyperMind 02 - Fourteen adopted capabilities, one wave per group"
status = "in_progress"
spec_version = "1.0.0"
date = "2026-09-16"
intro = "Adopt fourteen capability groups onto the engine built by hypermind-01, each as one wave of bounded tasks that ends in a runnable surface. The engine gains source kinds it did not have (documents, authorized web sources, media, repository snapshots, imported vocabularies, imported playbooks and signed external deliveries), retrieval it did not have (a relation lane, a graph mode, evidence paired with every summary, support provenance in the manifest and a bounded ranking preference learned from attestations), honesty it did not have (classified provider outcomes, typed extraction contracts, run reservations, declared extraction windows and metadata-only telemetry), operational reach it did not have (a signed portable archive, daemon leases, provider call admission, capability discovery, a C ABI, an inspection console) and evaluation it did not have (criterion-level probe grading, a single-variable retrieval sweep and a cross-SDK behavioural contract proved across a crash restart). The ledger stays the only memory authority, the tool inventory stays at fourteen verbs, nothing derived gains observed authority, no model runs on the recall or activate path, and every limitation this environment imposes is written down rather than claimed away."

[design]
overview = "Fourteen groups, fourteen waves, one group per wave in the order they were adopted: documents; web sources and media; the repository graph; provider outcomes, extraction contracts and reservations; vocabulary and alias review; relationships, paired evidence and support; extraction windows, playbooks and proposals; ranking preference; admission, bounded extraction and leases; the C ABI and the Apple package; archives, telemetry and discovery; source connectors; the console; probe benchmarking and the cross-SDK contract. Each wave is a vertical slice: a task carries its consumer, or its consumer is a later task in the same wave ordered after it. The design sections below record what each wave decided once, in HyperMind's own vocabulary, and design.amendments records every place this feature extends a hypermind-01 acceptance criterion."

[design.authority]
title = "Authority, scope and relationship to hypermind-01"
source_of_truth = "spec/hypermind-01/spec.kvx remains the implementation contract for the engine. This file records hypermind-02: fourteen capability groups adopted on top of it, built as one wave per group. Every hypermind-01 design section and acceptance criterion still holds; nothing here relaxes one."
scope = "hypermind-02 adds source kinds (documents, authorized web sources, media, repository snapshots, imported vocabularies, imported playbooks, signed external deliveries), retrieval surfaces (a relation lane, a graph mode, paired evidence, support provenance, bounded ranking preference), operational surfaces (archives, telemetry, capability discovery, leases, admission), embedding surfaces (a C ABI and an Apple-platform package), an inspection console, and evaluation surfaces (probe benchmarking, a retrieval sweep, a cross-SDK behavioural contract)."
completion = "The feature is complete when every task is done, every group's verify command passes at the merged revision, and the honest limitations recorded in design.limits are still the only ones outstanding."
non_goals = ["A second memory authority beside the ledger, or a second key system beside the actor key hierarchy", "A fifteenth MCP verb, a new error code in the frozen numeric wire ABI, or a renumbered event union member", "Any model call on the recall or activate hot path", "Claiming a gate that cannot run in this environment"]

[design.invariants]
title = "Invariants every group obeys"
authority = "The ledger is the only memory authority. Every read model in this feature is a projection rebuilt from events and is byte-identical after a reset rebuild. Derived content carries derived_inference with full model provenance; nothing derived gains an observed class; an imported declaration is user_asserted or external_observed and is never promoted."
verbs = "The MCP tool inventory is frozen at fourteen verbs. Every new capability is a new argument object, a new action-enum variant, a new mode, or a new hm:// target inside an existing verb. The dispatcher table, the protocol verb allowlist, the REST verb array and the generated tool catalog are unchanged by every group."
versions = "Every persisted or wire-visible type carries a version. Event union members are appended, never renumbered, so an already-durable frame keeps its meaning; new scalar fields decode as zero on legacy frames and the validator accepts that as not declared."
background = "Consolidation, extraction, relationship embedding and media derivation are background, budgeted, generation-scoped work. Nothing in this feature calls a model from recall or activate, and each group carries a test that proves its provider fixture is left unconsumed on a read path."
determinism = "Scoring added by this feature is integer fixed point with no floating point, so results are bit-reproducible across architectures. Identities are content-derived, domain-separated blake3 digests with length-prefixed components."
tests = "Tests exercise real code paths with real types: real ledgers, real projection stores on temporary directories, real actor engines, real daemons. Provider and network behaviour is exercised through deterministic local providers and recorded transports whose fixture exhaustion is asserted. No stub, mock, fake or placeholder of a HyperMind type exists anywhere in this feature."
docs = "The generated reference catalog is byte-exact. Any task that adds a public item, a prompt file, a config key, a CLI declaration or a tool description regenerates the catalog and commits it in the same change; a new crate carries its guidance entry before its first public item exists."

[design.documents]
title = "Wave 1 - Documents"
summary = "A document is a ledger source kind: the original bytes are retained once, extraction is versioned per loader, chunks are byte ranges that tile the extracted text, and a revision is a validated change plan rather than a rewrite."
decisions = "A dedicated pure library holds loaders, chunking, identity and change plans, with no async runtime, no ledger and no projection dependency. Three additive event kinds carry the ingested artefact, its extraction and its chunking. Chunk offsets are into the extracted text and tile it exactly, so concatenating the ranges reproduces the text byte for byte. Identity is a domain-separated digest over the document id, the chunk content hash and an occurrence number counted over the final document order. Publication reuses the existing generation machinery as a single extract-only run whose close is the compare-and-swap. Stored chunks are read through a generation-scoped projection, never by rescanning frames."
limits = "Office archive formats are out of scope. Document chunks are not separately embedded in this wave. The checked-in wire trees for the other language SDKs are not regenerated, so those SDKs cannot decode the three new tables yet; the union members are appended so every existing decoder keeps its discriminants."

[design.sources]
title = "Wave 2 - Web sources and media"
summary = "An authorized fetch retains the original bytes in the ledger, records the final URL, the normalised media type and a content digest, extracts text when the payload is textual, and leaves transcription and description to an explicit background job."
decisions = "No schema change: the source metadata, the retained bytes and the derived text all reuse existing payloads. Retained bytes live in a conversation derived from their digest so a multi-megabyte payload never enters the caller's conversation heads. Automatic redirect following is disabled and every hop is re-validated against the crawl policy, including a refusal of non-routable destinations decided on both literal addresses and every resolved address. Derived text carries derived_inference and a model provenance whose call id is a digest over the media digest and the derivation kind, which is also the join key the media catalog indexes. Extraction of textual payloads is pure, dependency-free and bounded."
limits = "Deployment configuration for the fetcher and the media provider is environment-driven rather than daemon config keys. No test in the group reaches the network; fetches and provider calls run through recorded transports."

[design.repository]
title = "Wave 3 - Repository graph"
summary = "A repository snapshot is a caller-supplied, newline-delimited document that the engine reads, resolves and derives a graph from, with no subprocess, no download and no model call anywhere on the path."
decisions = "The snapshot rides into the ledger as externally observed provider frames chunked on line boundaries, so a fact's byte range never straddles two events. Facts are six kinds and relations are eight names; anything else is counted and dropped. Node and edge identity are content-derived so the same fact addresses the same record in a later snapshot. The extraction run declares the existing single non-model phase and one contract entry rather than inventing a phase or a prompt. Re-extraction revises a node already visible in the active generation instead of re-minting it. Retracting facts a newer snapshot no longer declares is explicitly out of scope and is stated in the documentation."

[design.extraction]
title = "Wave 4 - Provider honesty and run reservations"
summary = "A response outcome classifies what a provider actually returned; an extraction contract states the exact shape a structured response must satisfy before anything derived from it is staged; a run reservation refuses an attempt the declared budget cannot afford before it is made."
decisions = "Both vocabularies live in the provider crate, which is the only crate both cognition and compose already depend on, and both carry their own version number that is emitted into the envelope. One new provider error variant carries every classified outcome; the existing variants keep their meanings. Identifier bounds are counted in characters rather than bytes and sit below the ledger's own identifier ceiling, so a value that passes the contract can never be refused later for length. Diagnostic text names the field and the observed length and never the offending value. The surface mapping is frozen for the group and adds no error code; the distinction the shared code loses is carried as a typed gap and a warning. Reservations cover calls, tokens and cost; wall time stays with the existing tracker."

[design.vocabulary]
title = "Wave 5 - Vocabulary and alias review"
summary = "A vocabulary is a versioned, source-backed set of terms an operator imports into one actor. It widens what the graph lane can reach, and fuzzy resemblance stays a reviewable proposal that is never persisted."
decisions = "One additive event kind carries the whole import; an accepted alias is expressed by importing a new vocabulary version that declares it, never by a merge event, so a suggestion can never silently change matching. The import must carry user_asserted authority, which is deliberately not an observed class. Normalisation lives once in the index crate and is Unicode-aware and idempotent. Similarity is integer fixed point over distinct adjacent character pairs counted in scalar values. The projection keys term records by version so definitions are never overwritten in place, and an import whose version does not advance the head is recorded as seen while the checkpoint still advances. The graph lane resolves exact normalised names only."
limits = "Line-based RDF triples are the only source format implemented; other serialisations are a later additive parser and media-type string, not a schema change. The checked-in wire trees for the other language SDKs are not regenerated."

[design.relations]
title = "Wave 6 - Relationships, paired evidence and support"
summary = "A relationship representation is the deterministic text a relationship embedding is built from; the relation lane ranks relationships directly; paired evidence returns the original observation behind a summary; support provenance separates the evidence that produced a derived claim from the text that merely reached the prompt."
decisions = "Relationship embeddings reuse the existing embedding record with the asserting event as their target and a dedicated space whose identity carries the lane, so they can never collide with the document lane. Representation identity is a domain-separated digest over the edge and both endpoints. Lane and reason enums grow by appending, because their discriminants are written into the canonical bundle bytes. The manifest's support list is serialised last and is deliberately not part of the manifest identity preimage, so stored manifests keep validating. Paired evidence is pairing rather than fusion: it inherits its summary's position and disappears with it. The geometric boost follows the existing optional-rerank gate verbatim: off by default, version-gated and refused without measured evidence of a gain."

[design.procedures]
title = "Wave 7 - Windows, playbooks and proposals"
summary = "An extraction window is the inclusive ledger range a background run declares it consumed; a watermark is the highest such end among published runs for a scope; a playbook is an externally authored procedure imported as an untrusted proposal; an improvement proposal links failing observed outcomes to a drafted replacement."
decisions = "Two additive event kinds carry the import and the proposal, each with its authority class pinned at admission, so a drafted proposal stays permanently outside the observed classes. The learning ladder is extended rather than weakened: a fourth, strictly weaker state is appended and the three existing states keep byte-identical semantics and transitions. Playbooks and proposals live inside the existing procedures projection under new key prefixes, so no projection is added; the listing path scans only the head prefix, which is what makes discovery metadata-first by layout. A proposal is admissible only against the head's current version, and adopting one snapshots the outgoing head before installing the new one. Stale-version checks happen twice, once before commit and once in the projection."
limits = "The checked-in wire trees for the other language SDKs are not regenerated for the two new tables; the Go toolchain is absent from this environment and a regenerated tree could not be compiled here."

[design.preference]
title = "Wave 8 - Ranking preference"
summary = "Answer-level feedback is the existing attest verb. Every attestation advances a bounded ranking preference for the evidence it names, and that preference multiplies a ranking score and nothing else."
decisions = "The weight lives under a second key prefix inside the existing attestations projection, so the existing record layout is byte-identical and no on-disk migration is needed. The update rule is integer-only, applied in strict event order at projection-apply time, and clamped into a band no sequence of events can leave. A target with no attestation has no record and resolves neutral, so every preference-aware path is a no-op with no feedback. Score adjustment is defined exactly once and both fusion and the daemon recall path call it. Weights live in the actor's own environment and no interface accepts a foreign actor id."

[design.concurrency]
title = "Wave 9 - Admission, extraction and leases"
summary = "Three independent limiters that are never merged: admission bounds concurrent provider calls, budgets bound spend, and leases bound simultaneously active actors and heavyweight jobs."
decisions = "Each limiter has its own refusal so one can never be reported as another. The per-item outcome vocabulary is exactly extracted, failed, skipped and aborted, each carrying its source index and sorted back into source order before it is returned. The stop flag is read at dispatch time only, which is the last point at which a paid call can still be avoided; nothing in flight is cancelled and nothing already paid for is discarded. A content-level drop is data, not a failure, and never stops dispatch. Every ceiling of zero clamps to one so a misconfiguration serialises rather than deadlocks. Fair admission is a per-actor in-flight cap rather than a ticket queue, and an actor already holding a lease is never refused another, which is what stops a newly arriving actor from starving one whose work is already in flight."

[design.embedding]
title = "Wave 10 - The C ABI and the Apple-platform package"
summary = "A C-callable edge over the embedded kernel with explicit handle ownership, a boundary status tier distinct from the kernel error code, one call entry point and a drift-checked header; and a source-only Apple package over it."
decisions = "The ABI is the only crate in the feature that allows unsafe code, and it does so in its own lint table rather than by changing the workspace defaults. Handle lifecycle is split three ways: open builds the state, clone shares it by reference count, close shuts the actor down deterministically for every clone and is idempotent, and free releases exactly one pointer. Configuration arrives as a strict JSON object so an embedder never passes key material positionally. One call entry point forwards a verb string to the existing dispatcher, so the ABI is a transport and not a verb. Header drift is caught by a real test that reconciles the exported symbol names, the status table and the published declarations, rather than by a code generator."
limits = "No Swift toolchain exists in this environment. The Apple package is source with a test suite that is explicitly not run here, and the checked-in gate proves only binding fidelity: symbols, status values and the verb inventory."

[design.operations]
title = "Wave 11 - Archives, telemetry and discovery"
summary = "A signed single-file archive for moving an actor's memory, opt-in metadata-only span export, and capability discovery as a mode of the existing inspect verb."
decisions = "The archive is a line-oriented native container over the existing event transfer format, adding no compression or archive dependency; its manifest digest is signed with the actor's existing checkpoint signing key under its own domain string so an archive signature can never be confused with a checkpoint. Verification is key-free. Member names are compared by exact equality against an owned-member allowlist before any path is constructed. Telemetry redaction is structural: a span attribute admits only a static key with an integer, boolean or static-string value, so no runtime string can reach a span at all. Telemetry is enabled only by an explicit command-line flag. Discovery is a static catalogue that reads no ledger, lists unavailable and privileged surfaces rather than hiding them, and carries a warning that discovery is not authorization."

[design.connectors]
title = "Wave 12 - Source connectors"
summary = "A source connector is a durable binding between one actor and one external source provider. Signed deliveries land in a durable inbox exactly once, credentials rotate additively under the actor's own key hierarchy, and revision heads record what an authorized pull observed."
decisions = "Four additive event kinds carry the binding, the accepted delivery, its settlement and an observed revision, with authority pinned per kind at admission. Identity sizes are fixed and validated. Credential secrets never leave the actor writer thread: the vault seals them under the existing data key with associated data binding the actor, user, provider, connector and version, and the actor exposes verification and consent operations rather than secrets. The signature scheme is HyperMind's own canonical base compared in constant time inside a freshness window, so an edge adapter maps a provider's own header set into this envelope. Consent state is single use, bound to its provider and connector, and its redeemed nonce is a durable projection record checked at admission. Retry is a bounded exponential schedule so settlement events are deterministic."
limits = "The live outbound transport has no test in this environment; outbound sync is exercised through a recorded transport that pins the request shape. The checked-in wire trees for the other language SDKs are not regenerated."

[design.console]
title = "Wave 13 - The console"
summary = "The console is an inspection surface over authoritative daemon data: sources and their entity contributions, the evidence path and its reverse lookup, the retrieval manifest, the server-authoritative access table, removal previews, a domain profile, resumable uploads and a live activity feed."
decisions = "The console is a workspace package in the existing TypeScript SDK tree with no new build tool, bundler or framework, compiled twice from one flat source tree: one output for tests and one for the browser. Every server surface it reads is a new hm:// target inside the existing inspect verb, plus one optional manifest object on the activate envelope that is skipped when absent so every other verb's bytes are unchanged. The evidence vocabulary is fixed: an evidence path is a record reference walk, never a model's reasoning, and retrieved, included and attested are three independent facts the console never collapses. Removal previews are diagnostics that write nothing and say so in their own payload. Permissions are never computed in the console; the access view raises rather than inventing a default. Every view is a pure builder plus a pure renderer and every server string is escaped."
limits = "The REST listener requires mutual TLS, so a browser reaching the console must present a client certificate. No test in the group renders in a browser or drives a DOM; tests assert view models, HTML strings, served bytes and real daemon responses only."

[design.evaluation]
title = "Wave 14 - Probe benchmarking and the cross-SDK contract"
summary = "A normalized probe set with criterion-level grading and a deterministic ordering metric, a single-variable retrieval sweep with an identity-bound cache, and a behavioural contract that compares every reachable SDK against one real daemon across a crash restart."
decisions = "All of it lands inside the existing evaluation crate; no crate is added. A judge failure is not a wrong answer: the criterion stays ungraded, the probe stays unscored, and both are counted and reported beside the mean. Ordering probes are scored judge-free and counted separately inside the judged summary. Every cache directory is named by an identity over the format tag, the probe-set digest, the full variant record and an implementation digest of the owning module, and every read re-derives that identity and hard-errors on a mismatch. The criterion prompt is a versioned file bound in by inclusion; changing its wording requires a new version file, never an edit in place. Cross-SDK legs are dumb recorders that write raw envelopes; all normalization and comparison happens once, in one place."
limits = "The Go toolchain is absent from this environment and the Python SDK's runtime dependencies are not installed, so those legs record an availability reason and are excluded from the agreement assertion rather than stubbed. The gateway is opened without live access outside an explicit operator invocation, so an uncached request is a hard error rather than a network call."

[design.limits]
title = "What this feature does not claim"
toolchains = "Swift and Go toolchains are absent from this environment and no live provider or network is reachable here. No Swift or Go test run is claimed anywhere in the repository, and every verify command in this feature covers only what really runs here."
wire_trees = "The checked-in FlatBuffers wire trees for the Go and TypeScript SDKs are not regenerated for the event kinds added by waves 1, 5, 7 and 12. Every new union member is appended, so existing discriminants and existing decoding are unaffected; those SDKs simply cannot decode the new tables yet. This is recorded rather than hidden."
transports = "The live HTTP source transport of wave 12 and the live fetch path of wave 2 compile but are exercised only through recorded transports here."

[design.amendments]
title = "Amendments to hypermind-01 acceptance criteria"
note = "Every amendment below is additive. No listed item loses its identity, its position or its behaviour, and no existing test changes."
req_5_ac_3 = "hypermind-01 req.5 ac_3 enumerates the projections present at v1.0. Amended wording: that enumeration is a floor rather than a ceiling. Every listed projection keeps its identity, index, name and behaviour; waves 1, 2, 5 and 12 append further projections after the listed ones, and each addition is recorded in the generated reference catalog."
req_6_ac_2 = "hypermind-01 req.6 ac_2 and design.retrieval fusion name exactly one optional rerank. Amended wording: a second optional ranking change may be added under the same rule verbatim - off by default, version-gated, and refused without evaluation evidence of a measured gain. The composite formula is untouched: any such factor multiplies the already-computed composite and never changes how reciprocal rank, retrievability, salience and recency combine. Wave 8's bounded preference is applied after the composite in the same way, and is neutral by default."
req_6_ac_3 = "hypermind-01 req.6 ac_3 lists the recall modes. Amended wording: wave 3 adds the graph mode and wave 6 adds the relation mode inside the existing recall verb, moving the surface toward that list. The as-of mode remains outstanding and is not claimed by this feature."
req_7_ac_2 = "hypermind-01 req.7 ac_2 enumerates the retrieval manifest as carrying candidates, selected, included and used. Amended wording: a fifth list, the support provenance of surviving derived items, is appended at the very end of the canonical stream. The four named lists keep their meaning and their positions, and the manifest identity preimage is unchanged."
req_9_ac_1 = "hypermind-01 req.9 ac_1 requires every derived record to carry run_id, model_provenance and citations, written for model-driven consolidation. Amended wording: a deterministic extraction run satisfies all three honestly - the run id names the snapshot digest, the provenance names the deterministic extraction contract with zero tokens and zero cost, and every node and edge cites the byte range of the snapshot line it came from. Zero-cost provenance is admitted only for a pinned identity, exactly as the existing deterministic import is."
req_9_ac_1_repair = "hypermind-01 req.9 ac_1 states that NREM makes one structured-output call per cluster. Amended wording: one call per cluster remains the default for every existing caller. A second call is made only for a classified repairable outcome, only once, and only when the run's own reservation admits it, so the per-cluster call count stays declared and bounded."
req_9_ac_3 = "hypermind-01 req.9 ac_3 requires a run to declare its four budget dimensions and abort cleanly on any. Amended wording: a run that spends nothing still declares them and reports honest zero usage, and a reservation that refuses an attempt before it happens only ever makes a run stricter. The existing post-phase budget check and the existing wall-time check are retained, so a genuine overrun still aborts the phase. A provider outcome on one candidate is a per-candidate result rather than a budget violation: the run completes and reports failed and skipped counts."
req_12_ac_2 = "hypermind-01 req.12 ac_2 and design.records procedure describe procedures mined from observed episodes in three states. Amended wording: a fourth, strictly weaker state is appended for an imported playbook. It carries no episode support, so the three-roots-two-conversations rule for the supported state is untouched; it never renders at all, so the rule that only adopted procedures render as instructions holds a fortiori; and it can leave that state only through the existing user-authority adoption or a later mined revision carrying real episode support."
req_13_ac_2 = "hypermind-01 req.13 ac_2 fixes the MCP verb inventory. Amended wording: the inventory stays exactly as it is. Every capability added by this feature is an argument object, an action-enum variant, a mode or an hm:// target inside an existing verb, and the C ABI's call entry point is a transport that forwards a verb string to the same dispatcher, which refuses anything outside the inventory."
req_13_ac_3 = "hypermind-01 req.13 ac_3 enumerates the command-line surface. Amended wording: no listed command changes or is removed; wave 11 adds an archive command alongside export and import, and waves 11 and 13 add options to the serve command. Every addition honours the existing global JSON flag."
req_14_ac_1 = "hypermind-01 req.14 ac_1 enumerates the Rust, TypeScript, Python and Go SDKs. Amended wording: that list is not exhaustive of embedding surfaces. Wave 10 adds a C ABI over the embedded kernel and a source-only Apple package above it; neither removes, renames or weakens a listed SDK, and the daemon-backed suites named in that criterion are untouched. The Apple package is delivered with its limitation stated rather than with a claimed gate."

[documentation]
mode = "manual"
status = "pending"
audiences = ["developer", "operator", "user"]
targets = ["docs/concepts/**", "docs/guides/**", "docs/reference/**", "docs/evaluation/**", "docs/SUMMARY.md", "docs/tools/usage.json"]
verify_cmd = "cargo run --locked -p hm-eval -- docs-gate"

[req.1]
title = "Documents as a ledger source kind"
story = "As a user, I need to hand the engine a document and have it stored, extracted and chunked without losing the original bytes, and to revise it later without the engine silently rewriting what it already held."
ac_1 = "Three document event kinds are additive schema members; the ingested artefact is external_observed and the extraction and the chunking are derived_inference; chunk byte ranges tile the extracted text exactly and admission refuses an envelope that breaks the ordinal sequence or the tiling chain."
ac_2 = "The loader seam covers plain text, delimiter-separated tables, PDF and RFC 5322 mail; every span is a byte range into the extracted text so a row, a cell or a page can be sliced back out; a partial extraction is data carrying a reason and the units that failed, and only a total failure is an error."
ac_3 = "Chunk identity is content-derived and occurrence-numbered, so an untouched chunk keeps its id across an edit and two identical paragraphs stay two chunks; the change plan classifies every chunk retained, moved, replaced or added, and a reconstruction gate refuses any plan that does not reproduce the new text byte for byte."
ac_4 = "Stored chunks are read through a generation-scoped projection and published as one extract-only consolidation run, so an unpublished or retracted generation is invisible; the whole surface lives inside the existing remember verb and the tool inventory is unchanged."

[req.2]
title = "Authorized web sources and explicit media derivation"
story = "As a user, I want the agent to take in a page or a media file I authorised, keep the original, and make it searchable, without a model ever being called on the recall path."
ac_1 = "An authorized fetch is bounded by an operator-declared host allowlist, a response-size limit, a redirect budget, a per-host minimum interval and a refusal of non-routable destinations that is re-checked on every redirect hop; every refusal maps onto an existing error code and no new code is minted."
ac_2 = "The fetched bytes are retained verbatim as one sealed ledger record, the source metadata records the final URL, the normalised media type and the content digest, and text extracted from a textual source carries external_observed authority with no model provenance."
ac_3 = "Transcripts and descriptions are produced only by an explicit derivation job reachable through remember and never from recall or activate; every derived chunk carries derived_inference authority and a complete model provenance whose call id is derived from the media digest alone."
ac_4 = "A media catalog projection rebuilt from the ledger answers what media the actor holds and what still awaits derivation, is readable through the existing inspect verb, and makes a repeated derivation a no-op that spends no provider call."

[req.3]
title = "A repository graph derived from a caller-supplied snapshot"
story = "As a developer, I want the agent to understand the shape of my repository from a snapshot I produce myself, and to answer why and how questions by walking it, without the engine ever running or installing a program of mine."
ac_1 = "The snapshot reader is deterministic and model-free: a pinned contract id, six fact kinds, eight relation names, a byte range cited for every surviving fact, unknown input counted and dropped, and a fail-closed error for a wrong contract, a count mismatch or an oversized document."
ac_2 = "Relations resolve by exact name and then by unique suffix; ambiguous, unresolved, self-referencing and out-of-vocabulary relations are dropped with a typed reason; edge weight counts distinct declaring facts and never a model score."
ac_3 = "The extraction run is a generation-scoped consolidation run that declares its budget and reports zero calls, zero tokens and zero cost under one pinned deterministic identity admitted by schema validation; re-running the same snapshot is a duplicate, and a changed snapshot revises a node rather than minting it twice."
ac_4 = "A snapshot is ingested through the existing remember verb, indexed by the entity projection, and traversed through a graph mode of the existing recall verb whose items carry derived_inference authority, the asserting event and the cited snapshot lines."

[req.4]
title = "Honest provider outcomes, typed extraction contracts and run reservations"
story = "As an operator, I need to know whether a provider refused, ran out of room, produced unparseable text or answered incompletely, and I need a run to refuse work it cannot afford before it spends the money."
ac_1 = "One versioned response-outcome vocabulary of refused, truncated, malformed and incomplete is classified identically on every provider, carries the usage the provider reported for the failed attempt, and never echoes the model's returned content into a diagnostic."
ac_2 = "A typed, versioned extraction contract validates a structured response exactly in both directions before any derived record is staged: a missing field and an invented field are both refusals, identifiers are bounded in characters below the ledger's own identifier ceiling, and prose and list fields carry their own separate bounds."
ac_3 = "A run reserves one call and its output ceiling before each provider attempt and settles the real usage afterwards, including the usage of a failed attempt; a refusal is never re-asked, a truncated or malformed answer is re-asked at most once, and a retry the reservation cannot admit drops the candidate instead of overrunning the declared budget."
ac_4 = "The outcome reaches the surface inside existing verbs: recall in reconstruct mode reports it as a typed gap beside the mapped error code, and the consolidate envelope reports the declared limits, the settled usage and the retry count."

[req.5]
title = "Imported vocabulary and reviewable alias matching"
story = "As an operator, I want to declare the terms my domain uses so recall can reach a relationship named differently from my query, and I want a fuzzy resemblance to stay a proposal I review rather than a silent change to what the engine matches."
ac_1 = "A vocabulary import is one additive ledger event that must carry user_asserted authority, is bounded in terms, aliases and name length, and is refused with a protected-type write under any other authority class, so an imported term can never corroborate an observed claim."
ac_2 = "Name normalisation is Unicode-aware and idempotent and similarity is integer fixed point over distinct adjacent character pairs counted in scalar values, so scores are bit-reproducible across architectures and no floating point appears on the path."
ac_3 = "The vocabulary projection keeps a versioned head whose term records are keyed by version so definitions are never overwritten in place, resolves only exact normalised names, and rebuilds byte-identically; the graph recall lane widens on reviewed aliases only and never on a similarity score."
ac_4 = "Import rides inside the existing remember verb and review inside the existing inspect verb; an alias proposal changes nothing and is accepted only by importing a new vocabulary version that declares the alias."

[req.6]
title = "Relationship recall, paired evidence and support provenance"
story = "As an agent, I want to retrieve relationships directly, to see the original observation behind every summary I am handed, and to be able to audit which evidence produced a derived claim as opposed to which text merely reached the prompt."
ac_1 = "Relationship representations are deterministic and model-free, carry the asserting event and the sorted support LSNs, collapse a re-assertion to one representation, and refuse unusable input with a typed drop reason rather than skipping it silently."
ac_2 = "Relationship embeddings are built in the background after a consolidation publish, in their own embedding space, with derived_inference authority; they are never built on a recall path, a second run appends none, and a build failure is a gap and a warning rather than a failed run."
ac_3 = "A relation retrieval lane ranks relationships by edge identity with the asserting event and the evidence-counted weight, fuses with every other lane, and is reachable through a relation mode of the existing recall verb whose items keep the asserting event separate from the citation support."
ac_4 = "Every surviving summary is paired with the original observation it cites, in the same tier, carrying that record's own authority; the retrieval manifest records that support separately from included text, appended last in the canonical bundle bytes so the manifest identity is unchanged."
ac_5 = "The geometric relevance boost is integer-only, off by default, version-gated and refused without measured evaluation evidence of a gain; its ablation publishes both numbers and blocks no gate."

[req.7]
title = "Extraction windows, imported playbooks and improvement proposals"
story = "As a user, I want consolidation to read only what it has not read yet, and I want to bring in a procedure someone else wrote and improve one the agent already adopted, without ever overwriting what it was trusting."
ac_1 = "Every consolidation run declares the inclusive ledger window it consumed; the per-scope watermark is the highest window end among published runs, retracting a run rewinds it, and the next run reads only above it."
ac_2 = "An imported playbook is a separate and strictly weaker rung of the learning ladder: it carries external_observed authority, holds no episode support, can never reach the supported state, and never renders into an activation bundle until a user-authority adoption names it."
ac_3 = "Progressive disclosure is enforced by storage layout rather than discipline: no listing path can return an instruction body, and the body is reachable only through the dedicated read."
ac_4 = "An improvement proposal carries derived_inference authority, cites real observed failure events, is admissible only against the head's current version, leaves the head untouched, and on adoption snapshots the outgoing version so a previously adopted procedure stays readable forever."
ac_5 = "Every new surface is a variant of an existing verb's action vocabulary or a new hm:// target inside inspect; the tool inventory, the dispatcher and the wire allowlist are unchanged."

[req.8]
title = "Bounded ranking preference learned from attestations"
story = "As a user, I want telling the agent that an answer was helpful or harmful to change what it puts first next time, within a bound, without ever changing what it believes."
ac_1 = "Every attestation advances a bounded fixed-point ranking preference for its target event inside the existing attestations projection, in the same write transaction that carries the checkpoint, clamped into a declared band that no sequence of events can leave."
ac_2 = "The preference multiplies a ranking score only, after the existing composite; item content, authority and provenance and the belief, memory and graph projections are untouched, and a target with no attestation resolves neutral so behaviour with no feedback is bit-identical to before."
ac_3 = "Recall applies the actor's own weights to score-bearing modes only, reports the weight on the item and on the provenance URI when it is not neutral, and re-orders by score then event; chronological modes are unaffected."
ac_4 = "Weights are actor-local and rebuilt from the ledger: they survive a restart, they are inspectable through the existing inspect verb, and a preferences read naming another actor is not that actor's surface and is refused."

[req.9]
title = "Admission, bounded extraction and daemon resource leases"
story = "As an operator, I need three separate bounds - how many provider calls run at once, how much a run may spend, and how many actors and heavy jobs one daemon carries - and a refusal from one must never be reported as a refusal from another."
ac_1 = "Provider call admission is a blocking in-flight gate with a global ceiling, a per-actor share, a bounded wait, its own error variant and a counted refusal; a ceiling of zero serialises rather than deadlocks, and no single actor can occupy every slot."
ac_2 = "A consolidation candidate has a per-candidate entry point that records exactly one outcome for it, and the whole-run entry point folds over that entry point with byte-identical reporting so every existing vector still passes."
ac_3 = "Bounded-concurrency extraction records every item as extracted, failed, skipped or aborted, restores source order before returning, stops dispatching after a failure without cancelling anything already admitted, and never discards work already paid for."
ac_4 = "Daemon leases bound simultaneously active actors and heavyweight jobs, release on drop, are re-entrant per actor so an actor already admitted is never starved by a newly arriving one, refuse with a capacity error after a bounded wait, and are configured per deployment."
ac_5 = "Spend budgets are unchanged: exceeding a declared call, token, cost or wall-time limit still aborts the phase exactly as it did before."

[req.10]
title = "A C ABI for the embedded kernel and an honest Apple-platform package"
story = "As an embedder, I need to call the kernel from C with explicit ownership and precise error reporting, and I need the Apple package delivered honestly rather than claimed."
ac_1 = "The C ABI is a versioned, drift-checked surface: an opaque engine handle with separate clone, close and free, a strict JSON configuration carrying the actor and its sealed identity, a boundary status tier distinct from the kernel error code, and a test that reconciles the exported symbols, the status table and the published header."
ac_2 = "One call entry point forwards a verb string to the existing dispatcher and returns the envelope bytes verbatim; the callback fires exactly once when and only when the call was accepted, a panic is contained as a status rather than unwinding across the boundary, and a verb outside the inventory comes back as a capability denial."
ac_3 = "A real C consumer compiles against the published header with warnings denied, links the shared library, drives the surface through a blocking waiter, and releases every string and handle in the documented order."
ac_4 = "The Apple package is delivered as source with its limitation stated: no Swift toolchain exists in this environment, no Swift test run is claimed anywhere in the repository, and the checked-in gate proves only that the package binds symbols, status values and verbs that really exist."

[req.11]
title = "Portable archives, opt-in telemetry and progressive capability discovery"
story = "As an operator, I need to move an actor's memory as one signed file, to see what the daemon is doing without leaking what it remembers, and to let an agent discover capability without that discovery widening it."
ac_1 = "The archive is a signed, bounded, single-file container over the existing event transfer format with an owned-member allowlist; verification needs no decryption key and fails on any altered member byte, declared digest, declared length, signature or pinned public key."
ac_2 = "Unpacking verifies before it writes anything, validates member names by exact equality before a path is built, never overwrites, and import accepts an archive directly so an archive packed from one actor directory is recallable in another."
ac_3 = "Telemetry is opt-in, off by default and metadata-only by construction: a span attribute can only be a static key with an integer, boolean or static-string value, so no content, query, prompt, path, identifier or token can reach a span; spans cover the request edge, ingestion, extraction and provider calls and are on disk before shutdown returns."
ac_4 = "Capability discovery is a mode of the existing inspect verb over a static surface catalogue, reads no ledger, lists unavailable and privileged surfaces rather than hiding them, carries a warning that discovery is not authorization, and is proved over a real daemon connection to grant nothing."

[req.12]
title = "Authorized source connectors with a durable inbox"
story = "As a user, I want to bind an external source to my agent once, have signed deliveries land exactly once in a durable inbox, and have the credential rotate without a second key system and without a second memory authority."
ac_1 = "Four additive ledger records carry the connector binding, the accepted delivery, its settlement and an observed revision, each with its authority class pinned at admission; a wrong authority class is a protected-type write, and no error code is added to the frozen numeric wire ABI."
ac_2 = "Credentials are sealed under the actor's existing key hierarchy with associated data binding the actor, the user, the provider, the connector and the version; rotation is additive so every prior version stays decryptable, and no secret ever crosses the command channel or reaches an envelope, an item or a warning."
ac_3 = "A delivery is admitted only on a constant-time signature check inside a freshness window; a consent grant is single use and bound to its provider and connector; a repeated delivery id is reported as a duplicate rather than recorded twice; retries follow a bounded schedule and settle to abandoned once it is exhausted."
ac_4 = "The connector registry is a projection rebuilt from those four events, every surface rides inside the existing bind, remember and inspect verbs, and outbound sync goes through a recorded transport seam so no test in the group touches a network."

[req.13]
title = "The console"
story = "As an operator, I want to see what is in my agent's memory, which evidence produced which answer, what permission the daemon actually enforces, and what a removal would strand - without the page ever inventing an answer."
ac_1 = "New read surfaces live inside the existing inspect verb: sources and the entities they contributed through the kernel's own extractor, the evidence path as a record reference walk with a reverse answer lookup, the server-authoritative access table, and a removal preview that writes nothing and says so in its own payload."
ac_2 = "The activate envelope carries the retrieval manifest so retrieved, selected, included and used are distinguishable at the surface, and every other verb's envelope bytes are unchanged."
ac_3 = "Every console view is a pure builder plus a pure renderer over an authoritative envelope: a missing field raises rather than defaulting, permissions are read from the access surface and never computed locally, and every server-supplied string is escaped before it reaches HTML."
ac_4 = "The console is served as static assets from the existing actor REST listener behind the same mutual TLS as every other route, from a strict name allowlist, refused on the admin listener, and absent unless an operator configures it."
ac_5 = "Documents the console persists carry an explicit schema string and an integer version; an upload session reports degraded storage instead of claiming completion; the activity feed drops its cursor when the actor changes and classifies a rejected subscription rather than looping on it."

[req.14]
title = "Probe benchmarking and the cross-SDK behavioural contract"
story = "As the owner, I need long-context memory measured probe by probe with the judge's own evidence kept, and I need every SDK proved to behave identically against one real daemon, including across a crash."
ac_1 = "A normalized probe set validates its own shape, records the source artifact's digest, and bridges into the real ledger-backed benchmark pipeline; the in-repo fixture is original test material and a run over it is reported as incomplete so a fixture run can never be read as a benchmark score."
ac_2 = "Grading is per criterion and keeps the criterion text, the judge's evidence and the raw response digest; a judge failure leaves the criterion ungraded and the probe unscored rather than scoring it zero, and judge-free and judged numbers are reported separately and never blended."
ac_3 = "Ordering probes are scored by a deterministic tie-corrected rank metric over a deterministic aligner, so an ordering result needs no judge and is counted separately inside the judged summary."
ac_4 = "A retrieval sweep refuses any variant that changes more than one knob, caches each variant under an identity derived from the variant, the probe set and the implementation, and hard-errors on an identity mismatch rather than reusing a foreign result."
ac_5 = "The cross-SDK contract runs one fixed scenario of existing verbs against a real daemon across a real crash restart, compares normalized observations field by field, and records an absent runtime as unavailable with its reason rather than faking a leg."

[task.1.1]
title = "Document event kinds, payload validation and kind wiring"
status = "done"
wave = 1
section = "Wave 1 - Documents: retained originals, versioned extraction and replannable chunks"
owner_lane = "schema"
requires = []
reqs = ["1.1"]
touches = ["schemas/events.fbs", "crates/hm-schema/src/events_generated.rs", "crates/hm-schema/src/event.rs", "crates/hm-ledger/src/frame.rs", "crates/hm-ledger/tests/frame.rs", "crates/hm-cortex/src/authority.rs", "crates/hm-cortex/src/ingest.rs", "crates/hm-proj/src/checkpoint.rs", "crates/hm-schema/tests/documents.rs", "docs/reference/generated/schema-types.md", "docs/reference/generated/rust-types.md", "docs/reference/generated/coverage.json"]
verify_cmd = "cargo test -p hm-schema --test documents --test validation"
do_1 = "Add the three document event kinds to the canonical schema and to every enum and table that must know them, so the later tasks in this group have a ledger vocabulary to write into. In schemas/events.fbs add the enums DocumentCut and DocumentChange, the tables DocumentPageSpan, DocumentIngested, DocumentExtracted, DocumentChunk and DocumentChunked, append the member extract to ConsolidationPhaseName, and append DocumentIngested, DocumentExtracted, DocumentChunked to union EventPayload. Regenerate crates/hm-schema/src/events_generated.rs with planus 1.3.0 (/root/.cargo/bin/planus rust -o crates/hm-schema/src/events_generated.rs schemas/events.fbs); the file is a committed artefact with no build script."
do_2 = "Extend hm_schema::event::EventKind with DocumentIngested = 44, DocumentExtracted = 45, DocumentChunked = 46, add their TryFrom<u8> arms, put all three in is_wave_seven, put the two derived kinds in requires_run_id, add the payload_kind arms and the validate_payload arms with one validate_document_* function each. Mirror the three numbers in hm_ledger::frame::EventKind and grow its KINDS array to 46. Relax validate_consolidation_opened so an empty prompts list is accepted only when every declared phase is Extract."
do_3 = "Then close the exhaustive matches that will otherwise not compile: hm_cortex::authority::authority_for_event, hm_cortex::ingest (a new IngestSource::Document with its admission arms) and hm_proj::checkpoint::schema_kind."
do_4 = "Prove it: hm_schema::event::EventKind::try_from(44|45|46) and hm_ledger::frame::EventKind::try_from(44|45|46) both succeed and agree on the numbers; try_from(47) is Err in both. ConsolidationOpened with phases = [ConsolidationPhaseName::Extract] and an empty prompts list verifies; the same payload with phases = [ConsolidationPhaseName::Nrem] and an empty prompts list is still rejected with kSchemaInvalid."

[task.1.2]
title = "hm-docs crate with the loader seam, text loader and byte-exact table loader"
status = "done"
wave = 1
owner_lane = "documents"
requires = []
reqs = ["1.2"]
touches = ["Cargo.toml", "crates/hm-docs/Cargo.toml", "crates/hm-docs/src/lib.rs", "crates/hm-docs/src/loader.rs", "crates/hm-docs/src/formats/mod.rs", "crates/hm-docs/src/formats/text.rs", "crates/hm-docs/src/formats/table.rs", "crates/hm-docs/tests/loaders.rs", "docs/tools/usage.json", "docs/reference/generated/rust-types.md", "docs/reference/generated/coverage.json", "Cargo.lock"]
verify_cmd = "cargo test -p hm-docs --test loaders"
do_1 = "Create the crates/hm-docs library and the loader seam every format plugs into. Define LoaderId, the DocumentLoader trait (loader_id, extraction_version, extract), the Extraction record it returns and the LoaderRegistry that maps a media type and file name onto a loader. Extraction carries the extracted UTF-8 text, the page spans that partition it, an optional TableLayout for tabular sources, and an optional PartialExtraction describing what could not be extracted; partial extraction is data, only a total failure is an Err."
do_2 = "Implement two formats in this task. The text loader validates UTF-8 and returns the input bytes unchanged as the extracted text, with one page span covering the whole text. The table loader also returns the input bytes unchanged and additionally scans them as delimiter-separated records, producing a TableLayout with the header record's field texts, one RowSpan per data record and one FieldSpan per field, every span being a byte range into the extracted text so a row or a cell can be sliced back out of the original content exactly."
do_3 = "The scanner is written here rather than taken from a general-purpose reader because a general reader exposes field offsets into its own unescaped buffer, not into the source bytes, and byte-exact provenance is the requirement. Register the crate in the workspace members list and give it a crates.hm-docs entry in docs/tools/usage.json before any public item exists, or catalog generation throws."
do_4 = "Prove it: LoaderRegistry::standard().select('text/markdown', 'notes.md') and select('text/plain', 'a.txt') both return LoaderId::Text; select('text/csv', 'rows.csv') and select('text/tab-separated-values', 'rows.tsv') return LoaderId::Table; select('application/zip', 'a.zip') returns Err with code kOperationUnavailable. Both CRLF and LF line endings are accepted, and the delimiter is ',' for text/csv and '<TAB>' for text/tab-separated-values."

[task.1.3]
title = "PDF and mail loaders with explicit partial extraction"
status = "done"
wave = 1
owner_lane = "documents"
requires = ["1.2"]
reqs = ["1.2"]
touches = ["crates/hm-docs/Cargo.toml", "crates/hm-docs/src/loader.rs", "crates/hm-docs/src/formats/mod.rs", "crates/hm-docs/src/formats/pdf.rs", "crates/hm-docs/src/formats/mail.rs", "crates/hm-docs/tests/fixtures/two-pages.pdf", "crates/hm-docs/tests/fixtures/damaged-page.pdf", "crates/hm-docs/tests/fixtures/plain-message.eml", "crates/hm-docs/tests/fixtures/message-with-attachment.eml", "crates/hm-docs/tests/partial_extraction.rs", "deny.toml", "Cargo.lock", "docs/reference/generated/rust-types.md", "docs/reference/generated/coverage.json"]
verify_cmd = "cargo test -p hm-docs --test partial_extraction"
do_1 = "Add the two binary formats to the loader seam built in the previous task, each as its own module with its own extraction version, and make partial extraction explicit rather than silent. The PDF loader parses the document with lopdf, enumerates its pages, and extracts each page's text independently so that one unreadable page does not cost the rest of the document: successfully extracted pages are concatenated with a single newline separator and recorded as PageSpans carrying their one-based page number, while every page that fails is recorded in PartialExtraction.failed_units with a single readable reason. Only a document where no page extracts at all is an Err."
do_2 = "The mail loader parses an RFC 5322 message with mail-parser and renders a deterministic header block (From, To, Subject, Date, each on its own line) followed by a blank line and the plain-text body; attachments are not extracted, so a message carrying them reports them in failed_units with the reason naming them. Register both loaders in LoaderRegistry::standard() and extend select() with application/pdf and message/rfc822. Record the cargo-deny licence exception that lopdf's encoding_rs dependency requires, with the justification beside it."
do_3 = "Prove it: LoaderRegistry::standard().select('application/pdf', 'report.pdf') returns LoaderId::Pdf and select('message/rfc822', 'note.eml') returns LoaderId::Mail. cargo deny --locked check licenses passes with the recorded exception, and no other licence outside Apache-2.0, MIT and Unicode-3.0 enters the graph."

[task.1.4]
title = "Paragraph and row chunking that keeps the original byte offsets"
status = "done"
wave = 1
owner_lane = "documents"
requires = ["1.3"]
reqs = ["1.1", "1.3"]
touches = ["crates/hm-docs/src/lib.rs", "crates/hm-docs/src/chunk.rs", "crates/hm-docs/tests/chunking.rs", "docs/reference/generated/rust-types.md", "docs/reference/generated/coverage.json"]
verify_cmd = "cargo test -p hm-docs --test chunking"
do_1 = "Add the chunking module to hm-docs. Every chunk is a byte range into the extracted text, never a copied and reflowed string, so the stored bytes are never whitespace-normalised and the ranges always tile the whole text. Paragraph chunking groups the text into paragraph units separated by blank lines, batches consecutive units while the estimated token count stays inside the budget, and emits a span ending at ParagraphEnd; a unit that alone exceeds the budget is split at sentence boundaries with ParagraphCut on every piece but the last, and a sentence that still exceeds the budget is cut at the nearest UTF-8 character boundary."
do_2 = "Row chunking keeps a table record and its fields together: the header record becomes one span with row_index 0, each data record becomes one span with its one-based row_index and the full column range, and a record over budget is cut on field boundaries into RowCut spans carrying the covered column range, the last piece of the record always being RowEnd. Both chunkers attribute a page number to each span from the PageSpan that contains its start. Provide a tiles() predicate so callers and tests can assert the tiling invariant directly."
do_3 = "Prove it: For any non-empty text and any budget in 1..=MAXIMUM_TOKEN_BUDGET, chunk_paragraphs output satisfies tiles(&spans, text.len()): spans[0].byte_start == 0, spans[i].byte_start == spans[i - 1].byte_end for every i, and spans.last().byte_end == text.len(). A budget of 0 or above MAXIMUM_TOKEN_BUDGET is rejected with kInvalidArgument; empty text returns an empty span list."

[task.1.5]
title = "Content-derived chunk identity, occurrence numbering and region diff"
status = "done"
wave = 1
owner_lane = "documents"
requires = ["1.4"]
reqs = ["1.3"]
touches = ["crates/hm-docs/src/lib.rs", "crates/hm-docs/src/identity.rs", "crates/hm-docs/src/diff.rs", "crates/hm-docs/tests/identity.rs", "docs/reference/generated/rust-types.md", "docs/reference/generated/coverage.json"]
verify_cmd = "cargo test -p hm-docs --test identity"
do_1 = "Give chunks an identity that survives an edit and give the planner a way to find what actually changed. Identity is derived from content, never from position: a chunk's id is a domain-separated blake3 digest over the document id, the chunk's content hash and an occurrence number, so an untouched chunk keeps its id no matter where it moves, re-ingesting identical content is idempotent, and two identical paragraphs in one document stay two distinct chunks. OccurrenceCounter assigns those numbers over the final document order and can be told to reserve a number already claimed by a surviving chunk, so a fresh chunk never collides with one that is being kept."
do_2 = "The diff module returns the disjoint changed regions between two versions of the extracted text with the contract that the text outside the returned regions is byte-identical on both sides. It works on paragraph units from the chunking module: a common prefix and suffix of identical units is trimmed first, then units whose content hash occurs exactly once on each side become candidate anchors, the longest strictly increasing run of those anchors is kept, and the unit spans between consecutive anchors become the changed regions. Each region is then shaved to character precision by removing its common byte prefix and suffix, and regions that turn out to be empty on both sides are dropped."
do_3 = "Anchoring on near-unique units keeps the cost near-linear for any change shape instead of degenerating on repetitive content."
do_4 = "Prove it: chunk_content_hash is stable across calls and differs for two texts that differ in a single byte. For a document whose paragraphs are all identical, changed_regions still returns regions that satisfy the outside-is-identical contract rather than panicking or looping."

[task.1.6]
title = "Validated document change plan with a reconstruction gate"
status = "done"
wave = 1
owner_lane = "documents"
requires = ["1.5"]
reqs = ["1.3"]
touches = ["crates/hm-docs/src/lib.rs", "crates/hm-docs/src/plan.rs", "crates/hm-docs/tests/plan.rs", "docs/reference/generated/rust-types.md", "docs/reference/generated/coverage.json"]
verify_cmd = "cargo test -p hm-docs --test plan"
do_1 = "Turn the regions and identities into a complete, previewable change plan and refuse any plan that would lose content. A plan names every chunk the document will have after the edit, in final order, and classifies each one: Retained when a stored chunk keeps both its id and its position, Moved when a stored chunk keeps its id but shifts position, Replaced when a freshly cut chunk is byte-identical to one of the chunks it replaces and therefore keeps that id and everything derived from it, and Added when the content is genuinely new."
do_2 = "Planning starts by checking that the stored chunks tile the stored text; it then expands each changed region to the boundaries of the stored chunks it overlaps, merges runs that touch, re-chunks each region's new text through a caller-supplied region chunker so the plan stays independent of which chunker the document uses, and walks the final order once, interleaving kept chunks with region chunks and counting occurrences over that final order with the surviving ids reserved. Nothing between regions is ever re-chunked, so untouched chunks cannot drift. validate_plan is a separate, policy-agnostic gate that trusts none of the planner's arithmetic: it re-derives the document from the plan and refuses unless the ordinals are dense and unique, the byte ranges tile the new text, and the concatenated chunk texts are byte-identical to the new text."
do_3 = "Prove it: plan_initial marks every chunk Added, numbers ordinals 0..n-1, assigns occurrences 0, 1, ... per repeated content hash, and validate_plan accepts its output. plan_revision returns kInvariantViolation when the stored chunks do not tile the stored text, so a document that was chunked by something else falls back to a full rebuild instead of silently corrupting."

[task.1.7]
title = "Generation-scoped documents projection"
status = "done"
wave = 1
owner_lane = "projections"
requires = ["1.1"]
reqs = ["1.4"]
touches = ["crates/hm-proj/src/store.rs", "crates/hm-proj/src/documents.rs", "crates/hm-proj/src/lib.rs", "crates/hm-proj/src/generation.rs", "crates/hm-proj/src/runs.rs", "crates/hm-proj/src/rebuild.rs", "crates/hm-proj/tests/documents.rs", "docs/reference/generated/rust-types.md", "docs/reference/generated/coverage.json"]
verify_cmd = "cargo test -p hm-proj --test documents"
do_1 = "Add the read model for documents so a later edit can be planned against what the ledger actually published. ProjectionId::Documents is appended to the projection enum, the name table and the count, and a new module applies the three document kinds. DocumentIngested writes a document catalogue record that is not generation-scoped, because the original bytes and their digest are a plain fact about an artefact that entered the ledger."
do_2 = "DocumentExtracted and DocumentChunked are generation-scoped exactly like the memory, graph and review projections: they go through should_apply, resolve their generation from the run named by the envelope's run_id, write a generation-keyed head record, and stamp the staged marker that the publish compare-and-swap checks. StagedProjection gains a Documents member and the staged-kind table maps both derived kinds onto it, so ConsolidationClosed refuses to publish a run whose document records did not reach this projection. Reads gate on RunsProjection::is_readable and walk the lineage newest-first, so an open generation is invisible, a published one is visible and a retracted one falls back to its parent."
do_3 = "Wire the projection into GenerationProjection::apply_event before RunsProjection, and into rebuild_projection_stream's checkpoint arrays, generation block and reset_all."
do_4 = "Prove it: ProjectionId::COUNT is 19, ProjectionId::Documents.name() is 'documents', and the name table index matches the enum discriminant. A reset rebuild over the same frame sequence yields a byte-identical canonical_dump(ProjectionId::Documents)."

[task.1.8]
title = "Actor read of the active document state"
status = "done"
wave = 1
owner_lane = "kernel"
requires = ["1.7"]
reqs = ["1.4"]
touches = ["crates/hm-serve/src/actor.rs", "crates/hm-serve/src/lib.rs", "crates/hm-serve/tests/documents.rs", "docs/reference/generated/rust-types.md", "docs/reference/generated/coverage.json"]
verify_cmd = "cargo test -p hm-serve --test documents"
do_1 = "Give the surface a single authoritative read of what the ledger currently says about a document, so the change planner never rescans frames and never sees a retracted generation. Add one ActorEngine command and one public method that, for a given document id, opens a projection snapshot, resolves the active generation through RunsProjection, and returns the document catalogue record together with the extraction record and the chunk list visible in that generation's lineage."
do_2 = "A document that has never been ingested returns None; a document that was ingested but whose chunk run has not been published returns the catalogue record with no extraction and no chunks, which is exactly the state a retry after a crash must see. Follow the existing command pattern in crates/hm-serve/src/actor.rs for Procedure and Intention: a Command variant carrying the id and a reply channel, a thin async method built with request(), and a handler arm that begins a snapshot and calls the projection."
do_3 = "Prove it: ActorEngine::document_state on an unknown document id returns Ok(None). The method is reachable from another crate: crates/hm-mcp compiles against it in the next task without any further hm-serve change."

[task.1.9]
title = "Document ingestion inside the remember verb, previewed then published as a generation"
status = "done"
wave = 1
owner_lane = "surface"
requires = ["1.3", "1.6", "1.8"]
reqs = ["1.2", "1.4"]
touches = ["crates/hm-mcp/Cargo.toml", "crates/hm-mcp/src/tools/remember.rs", "crates/hm-mcp/src/tools/document.rs", "crates/hm-mcp/src/tools/mod.rs", "crates/hm-mcp/src/lib.rs", "crates/hm-mcp/tests/documents.rs", "docs/concepts/documents.md", "docs/SUMMARY.md", "docs/tools/usage.json", "docs/reference/mcp.md", "docs/reference/generated/tools.md", "docs/reference/generated/rust-types.md", "docs/reference/generated/coverage.json", "Cargo.lock"]
verify_cmd = "cargo test -p hm-mcp --test documents"
do_1 = "Wire the whole group together behind the existing remember verb, without adding a fifteenth MCP tool. RememberInput gains an optional document object carrying the artefact's name, media type, base64 content, an optional loader override, an optional token budget and a plan_only flag; content becomes optional so a document call does not have to send a redundant string, and sending both is rejected. The document path decodes the bytes, enforces the size cap, selects a loader, extracts, chunks with the paragraph chunker for prose and the row chunker for tables, reads the actor's current document state, and computes a change plan: a first ingest plans everything Added, a re-ingest of the same document id plans against the published chunk set."
do_2 = "The plan is validated through the reconstruction gate before anything is written, and the preview is returned in the envelope with per-chunk change kinds and the retained, moved, replaced and added counts. When plan_only is false the surface publishes in two appends: first the DocumentIngested event alone, so its LSN is known, then one batch containing ConsolidationOpened for an extract-only run, the started phase event, DocumentExtracted, DocumentChunked, the completed phase event and ConsolidationClosed with derived_records = 2, which is the compare-and-swap that makes the new chunk set visible. A partial extraction is reported as a gap and a warning, never as a silent success, and a failure of the second append leaves the original bytes retained with no generation published."
do_3 = "Prove it: The MCP tool inventory is unchanged: crates/hm-mcp/src/dispatcher.rs still exposes exactly fourteen verbs and crates/hm-serve/src/rest/mod.rs VERBS is still [&str; 14]. A plan that fails the reconstruction gate is refused with kInvariantViolation and nothing is appended."

