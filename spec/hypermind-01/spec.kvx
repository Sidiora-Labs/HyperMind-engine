touches = ["crates/hm-proj/src/store.rs", "crates/hm-proj/src/timeline.rs", "crates/hm-proj/src/lexical.rs", "crates/hm-proj/src/rebuild.rs", "crates/hm-proj/tests/**", "crates/hm-index/src/bm25.rs", "crates/hm-index/src/tokenize.rs", "crates/hm-index/tests/**"]
