# hypermind-01: the HyperMind memory engine, built as vertical slices.
# Authoritative implementation contract. KVX Dialect B. Generated Markdown mirrors are views.
# PLAN.md and HARNESS-LESSONS.md supply rationale; where wording differs, this file controls.

[meta]
feature = "hypermind-01"
title = "HyperMind 01 — Elite memory engine for agents, built vertically"
status = "draft"
spec_version = "1.0.0"
date = "2026-09-15"
intro = "Build HyperMind: a Rust memory kernel that fuses the neocortex ledger discipline (encrypted, tamper-evident, deterministic, bitemporal) with the cortex-engine cognitive loop (ingest, consolidate, forget, believe, adjudicate) and the harness lessons (evidence authority, required bindings, attention-gated anticipation, generations, byte-range citations, protected self). The system is a stack of eight layers and is built as eight vertical slices, each adding to every layer and ending in a runnable end-to-end journey. No wave builds one layer alone. Every wave ships an eval gate. The agent that uses HyperMind resumes where it left off, knows when things were true, notices when it is wrong, anticipates without interrupting, learns procedures from independent episodes, and proves where every recalled fact came from, on every turn, in under 10 ms, with no LLM on the hot path."

[design]
overview = "Eight layers: L0 schema and core, L1 ledger, L2 projections, L3 indexes and providers, L4 cognition, L5 compose, L6 surfaces and SDKs, L7 eval and docs. Eight waves: Spine, Continuity, Trust, Meaning, Belief and time, Sleep, Anticipation, Reach. Each wave is a slice through all eight layers. See design.body.md for the layer by wave matrix, the slice journeys and the ownership lanes."
include = "design.body.md"

[design.authority]
title = "Authority, scope and milestones"
source_of_truth = "This spec.kvx is the implementation contract. Its design sections and acceptance criteria are normative. PLAN.md and HARNESS-LESSONS.md are rationale and are not a second editable spec. Generated requirements.md, design.md and tasks.md are views."
location = "Canonical source is spec/hypermind-01/spec.kvx in the HyperMind-engine repository. The neocortex-engine and cortex-engine trees are read-only donors; their test vectors and fixtures are carried in, their code is ported, never linked."
milestones = ["W1-W2: a daemon an agent can remember into, recall from, checkpoint against and survive a crash with, over MCP, from Rust and TypeScript, with a fault simulator and an eval gate", "W3-W5: proof, meaning and time: verifiable without keys, semantic and entity recall under a deadline, bitemporal beliefs with adjudication and a protected self", "W6-W7: sleep and anticipation: consolidation as retractable generations with citations, prospective memory gated by attention, predictions with assessment, procedures earned from independent episodes", "W8: reach and qualification: gRPC, REST, Python and Go, migration from cortex-engine, docs site, published benchmarks, v1.0.0"]
completion = "The feature is complete when every task is done, every slice journey passes in CI, and the wave 8 benchmark run meets the targets in req.15. A milestone is usable on its own; an experimental lane left disabled after a completed and reported evaluation is acceptable and is named in the handoff."
non_goals = ["A second memory authority beside the ledger, or a graph database as a prerequisite", "Model weight training, parameter memory, or claims about intelligence beyond the measured behaviours", "Persona, social, content or mood features inside the engine; those are plugins", "Unauthenticated federation, or cross-process locking on one actor directory", "Runtime-cost minimisation as the definition of good; prioritise measured behaviour per slice"]

[design.build]
title = "Vertical build discipline"
rule = "The system is a stack, and it is built by stacking slices, not by pouring layers. A wave that adds a projection also adds the event that feeds it, the request that reads it, the tier or tool that surfaces it, the SDK call that reaches it, and the eval that measures it. A task that delivers a layer whose consumer is in a later wave violates this contract and is split."
waves = ["W1 Spine: remember and recall one thing end to end, survive a restart", "W2 Continuity: survive a kill mid-turn and resume the loop with exact bindings", "W3 Trust: prove the log without keys, never launder authority, shred with a receipt", "W4 Meaning: semantic, entity and planned recall that never blocks the turn", "W5 Belief and time: bitemporal beliefs, adjudication, a protected self", "W6 Sleep: consolidation as retractable generations with byte-range citations", "W7 Anticipation: wake triggers, attention, predictions, procedures", "W8 Reach: gRPC, REST, Python, Go, migration, docs, benchmarks, release"]
integration = "Each wave ends with one integration task that requires every lane task in the wave and whose verify_cmd runs that slice's journey test through MCP, daemon, ledger, restart and recall. Lane tasks in wave N+1 require the integration task of wave N. That dependency is what makes the build vertical: nothing in a later slice rests on an unproven layer."
scaffold = "Task 1.1 alone may create empty crates for later waves so the workspace compiles. An empty crate is scaffolding, not a layer. Adding behaviour to a crate that no task in the current wave consumes is a violation."
lanes = "Lanes are file scopes, not layers. The ledger lane contributes to every wave; so does the eval lane. Parallelism is across lanes inside one wave, never across waves."

[design.layers]
title = "The stack"
l0 = "hm-core and hm-schema: ids, revisions, error codes, FlatBuffers events (schema v2, additive over neocortex v1, file identifier NCEV) and protocol (v3 additive over neocortex v2, NCPR). Every persisted and wire-visible type carries a version."
l1 = "hm-ledger: 43-byte frame header, CRC32C frames, segment log with group commit, torn-tail repair and interior-corruption refusal, XChaCha20-Poly1305 sealing with AAD bound to actor, lsn, kind and user, Merkle Mountain Range over sealed bytes, Ed25519 checkpoints, idempotent append keyed by connection id and client sequence, tripwire LSN set, crypto-shred with signed receipt, key rotation."
l2 = "hm-proj: one LMDB environment per actor; each projection applies in one write transaction that commits mutations and its checkpoint together; rebuild from any prefix is byte-identical; generations with compare-and-swap publish, reader leases and retraction override. Projections: timeline, lexical, entities, vectors, beliefs, graph, memories, fsrs, intent frame, bindings, work ledger, intentions, attention history, predictions, procedures, attestations, temporal ladder, runs."
l3 = "hm-index and hm-embed and hm-llm: tantivy postings with fixed-point BM25; flat int8 vector lane with binary prefilter and an HNSW lane above 50k; rule-based entity index; embedder trait with local ONNX and remote providers, batched and content-hash cached, with space identity; LLM provider trait with Anthropic native, OpenAI-compatible, Gemini and Ollama, structured outputs only, a versioned prompt registry and cost accounting."
l4 = "hm-cortex: ingest with authority tagging, NREM cluster and merge and mint with citation validation, REM connect and abstract and hindsight, FSRS-6 review with retention classes and protection sets, adjudication ladder with in-process NLI and tier-capped LLM supersession, wake evaluation and attention scoring, prediction assessment and calibration, procedural mining with a learning ladder. Always background, always budgeted, always a generation."
l5 = "hm-compose: query planner, lanes, reciprocal rank fusion, optional reranker, ten-tier activation bundle with exact token counts, required tiers that are never shed, trim and coarsen policy, HMA1 canonical bytes, retrieval manifest, gaps and health, hard deadline with cached fallback."
l6 = "hm-serve, hm-mcp, hm-cli and sdk: Unix socket with NCPR framing, gRPC over mTLS carrying the same envelope bytes, REST with OpenAPI, MCP with thirteen verbs and one envelope, CLI and TUI, Rust embedded API, TypeScript napi and client, Python PyO3 and client, Go client extension, renderers with activation safety."
l7 = "hm-eval, hm-sim and docs: fault simulator, slice journeys, internal suites, LongMemEval, LoCoMo, BEAM, latency and cost and determinism reports, CI gates, schematics, ADRs, docs site."

[design.records]
title = "Minimum record contracts"
envelope = "EventEnvelope v2 = neocortex v1 fields plus origin_actor, run_id, model_provenance, authority, retention, sensitivity, event_time_ns. Frame header stays 43 bytes. The MMR leaf commits to the sealed bytes; a plaintext digest inside the sealed record supports content proofs."
authority = "authority is one of user_asserted, external_observed, tool_observed, runtime_fact, assistant_generated, derived_inference. Ingest sets it from source kind. Derivation lowers it to derived_inference unless the derived text is a verbatim quote of a cited byte range. It is rendered on every surfaced item and never omitted."
provenance = "ProvenanceRange = first_lsn, last_lsn, optional byte_start and byte_end into the cited payload. Provenance URI hm://actor/conversation/lsn with at, src, score, vr, lr, why and run query fields."
belief = "Assertion carries belief_id, type in fact, preference, constraint, goal, identity, canonical_identity, value, valid_from_ns, valid_to_ns, provenance ranges, conflict_domain, claim affirmative or negative_existence. identity, constraint and preference are protected: runs emit ProposedAssertion. Negative existence needs a corroborating tool_observed LSN in its provenance or admission fails with kNegativeExistenceUncorroborated."
binding = "Binding = task or scope, canonical entity, property, evidence LSN, revision, freshness requirement, status resolved or missing or stale or conflicting. Bindings are resolved from one snapshot independent of ranking and are never shed from a bundle."
intention = "IntentionSet = objective, WakeTrigger, expiry, reply route. WakeTrigger is one of at, schedule, child_terminal, process_exit, file_changed, repository_changed, channel_message, external_condition, user_response, entity_mentioned, loop_closed, prediction_resolved, belief_changed. IntentionFired carries a stable wake id used as an idempotency key. AttentionDecided is one of ignore, remember, batch, schedule, ask_user, start_work, notify with a user-readable reason."
prediction = "Predicted = immutable id and revision, task and attempt and operation linkage, bounded expected predicates (object exists in scope, revision or digest equals, receipt matches, typed property satisfies a bounded predicate, process terminated with observed result, answer committed), deadline, uncertainty text. OutcomeObserved = assessment supported or contradicted or pending or unresolvable or not_executed, observation LSNs, evaluator version."
procedure = "Procedure = conditional strategy, expected outcomes, preconditions, independent supporting episodes, failures and counterexamples, state tentative or supported or adopted. supported requires at least three independent source roots from at least two conversations. adopted requires a user-authority event. Only adopted procedures render as instructions."
memory = "Memory = name, definition, tags (open set with a curated core), salience, embedding reference, authority, retention, sensitivity, fsrs state, provenance, run_id. MemoryMinted, MemoryRevised, MemoryMerged, MemoryFaded are events; definitions are never overwritten in place."
edge = "Edge = source, target, relation, weight from evidence count, evidence LSNs, valid_from and valid_to, run_id. EdgeAsserted and EdgeRetracted are events."
run = "ConsolidationOpened = run_id, phases, prompt versions, model ids, budget. ConsolidationPhase records progress with a per-attempt idempotency prefix. ConsolidationClosed is the publish compare-and-swap. ConsolidationRetracted switches active_generation back."
manifest = "RetrievalManifest = query identity digest, snapshot epoch, encoder and index generation, candidate lanes, selected ids, included ids, used ids from attestation, gaps, degraded reasons, health."

[design.retrieval]
title = "Recall and activation"
planner = "Deterministic query-shape rules first: identifier-like queries lead with the entity lane; temporal phrases open a ladder window; why or how questions add graph expansion and procedures; otherwise semantic leads. A learned planner may replace rules only behind the eval gate."
lanes = "vector (binary prefilter then int8 dot, flat below 50k and HNSW above), lexical (fixed-point BM25), entity (exact postings), temporal (ladder descent and recency prior), graph (one to two hops over validated edges with validity intervals, at most 200 visited nodes), belief (as-of heads and obligated conflicts). Every lane is a pure index read."
fusion = "Reciprocal rank fusion over canonical ids, never raw scores across spaces. Composite = rrf times fsrs retrievability times salience factor times recency prior. Optional cross-encoder rerank of the top 32, off by default, enabled per deployment only when hm-eval shows a gain."
tiers = "resident, intent, bindings, work_ledger, prospective, conversation, entity, conflicts, fused, temporal. The first four are required and never shed; if they alone exceed budget the bundle narrows the active subtask and reports a gap. Trim sheds from the tail and coarsens conversation items to lsn plus first line before touching required tiers."
budget = "Token cost is exact per target model through tiktoken or HF tokenizers. Default allocation: mandatory 15 percent, intent and bindings and work 10, conversation 40, recall 15, tools 10, reserve 10. Optional segments shrink first."
deadline = "activate has a hard deadline, default 25 ms. On a miss it returns the conversation's last bundle marked degraded with stale_by_lsn and the query it was built for, and pushes the fresh bundle over Subscribe. The foreground SDK call cannot fail because memory is slow."
health = "semantic_ready, semantic_lagging, lexical_only, unavailable, reported separately for encoder, backlog, projection and actual inclusion. gaps[] lists missing or stale bindings, truncated lanes, index lag, dropped tiers and pending protected-type proposals. Silent degradation is a tested bug class."
rendering = "The SDK renderer emits typed sections with the authority class and provenance URI on every item; only semantic kinds; only items with full provenance; same-turn exclusion; no raw bytes; memory content never takes the system or developer role. Reconstruction output is labelled RECONSTRUCTION, carries assistant_generated, and the SDK refuses to remember it verbatim."

[design.cognition]
title = "Ingest, sleep and learning"
ingest = "Per turn: append episodic events with authority from source kind, embed batched and cached by content hash, extract entities, prediction-error gate against the nearest memory, Observed marker. No LLM. memory.* events are never re-ingested. retention do_not_store returns a receipt and writes nothing. Automatic sensitivity is capped at personal."
nrem = "Cluster unprocessed observations by embedding and entity overlap without an LLM. One structured-output call per cluster returns attach or revise or mint with citations. Every quoted span must be a substring of a cited byte range inside the run's frozen candidate set or the candidate is dropped and counted. Output authority is derived_inference unless verbatim. Mint requires at least three independent source roots from at least two conversations; a speculation-typed source poisons the candidate. Thought-quality and rewrite-guard run as measured classifiers with logged decisions."
rem = "Connect from cluster adjacency and entity co-occurrence with one long-context pass, never pairwise LLM calls; edge weight from evidence count. Abstract across tags with a novelty gate against store and run and a grounding floor. Hindsight defaults to no change; a concern must cite a neighbour or belief history; the rewrite guard declines lossy rewrites. Review with FSRS-6 from attestations, retrieval rank and contradiction involvement; retention class and the load-bearing protection set decide eligibility; the last K contradicted outcomes per domain are kept as counterexamples."
generations = "A run is a generation. Derived events are staged under run_id; ConsolidationClosed is a compare-and-swap publish that refuses if any staged record lacks a projection; readers lease a generation for a bounded time; retractions of a belief or memory apply to every generation, leased or not. Phases persist as events with a per-attempt idempotency prefix so a crashed run resumes. Retract switches active_generation back immediately; cleanup is background."
budgets = "Each run declares max_llm_calls, max_tokens, max_usd and max_wall_ms. Exceeding any aborts the phase cleanly and reports it. Every LLM-derived event carries model_provenance. Prompt ids and versions are snapshot-tested; a wording change requires a version bump."
adjudication = "In-process NLI in both directions yields genuine, tension, complementary or unrelated. genuine triggers one LLM call to test supersession on the time axis, producing either a Retract plus Assertion or a conflict edge with obligated surfacing. Models below the configured tier cannot declare genuine under 0.8."
anticipation = "Wake triggers are evaluated against new events; IntentionFired carries a stable wake id; the attention scorer combines urgency, expected value, confidence, interruption cost, resource cost and duplication penalty, applies quiet hours, notification budget and current workload, records AttentionDecided with a readable reason, and keeps a bounded history the user can inspect. Only notify, ask_user and start_work reach the bundle."
learning = "Predictions carry bounded predicates and a deadline; outcomes are assessed in five states; a revision_required gap is emitted after three same-mechanism failures with at most two revision rounds and five probes inside existing budgets. Procedures are mined from ToolCall to ToolResult to Effect to Outcome chains per closed loop and advance tentative to supported to adopted."

[design.surfaces]
title = "Protocol, tools and SDKs"
protocol = "Local: Unix domain socket, length and CRC32C prefixed FlatBuffer WireEnvelope, capability handshake, byte-compatible with neocortex proto_version 2; new requests are union members under proto_version 3. Remote: gRPC service carrying the same envelope bytes over mTLS with capability tokens, streaming Subscribe. Admin: separate token; Health, Stats, Verify, Rebuild, CryptoDelete, RotateKeys. Admin and actor requests never mix on one connection."
tools = "Thirteen MCP verbs with one envelope ok, items, provenance, budget, gaps, health, warnings: remember, recall, activate, believe, retract, dispute, intend, bind, predict, outcome, attest, consolidate, inspect, forget. Every mutation error carries effect_state in not_dispatched, unknown, rejected. MCP resources resolve hm:// URIs; an MCP prompt exposes the activate-backed system block."
cli = "hm init, serve, doctor, actor add or list or rotate-keys or shred, remember, recall, activate with a model budget, consolidate run or list or retract, verify, bench, export and import as JSON lines of events, tui."
sdks = "Rust crate hypermind (the kernel), TypeScript packages engine (napi), client (gRPC) and mcp, Python packages hypermind (PyO3) and client, Go client extended from cortexclient. Common contract: Session, remember, recall, activate to Bundle, render(bundle, model), attest, believe, intend, bind, predict, outcome, consolidate. Same envelope, same error codes."

[design.security]
title = "Security and privacy"
sealing = "Per-actor KEK to user key to data key; XChaCha20-Poly1305 with AAD bound to actor, lsn, kind and user; plaintext on disk refused with kLegacyPlaintext. Key rotation re-wraps the data key without rewriting the log."
integrity = "MMR leaves over sealed bytes so hm verify needs no key; Ed25519-signed checkpoints; every append ack returns leaf_count, leaf_hash and root; tool citations pin to a log prefix; crypto-shred writes a signed deletion receipt and zeroises keys."
tripwires = "Engine-seeded sealed records whose LSNs live in a kernel-held set; any activation, retract or forget touching one raises a security event. Never a flag inside the record."
isolation = "Actors are hard-isolated: own keys, log, LMDB environment, vector lane. Bridges forward selected kinds as new events carrying origin_actor. Federation is gRPC with mTLS and capability tokens only."
fuzzing = "libFuzzer-style targets via cargo-fuzz for frame, unseal, schema, protocol frame, query input and MMR state, run in CI smoke mode; Miri on the unsafe SIMD and mmap modules."

[design.evaluation]
title = "The merge gate"
principle = "No retrieval or consolidation threshold merges without a number. hm-eval runs in CI from wave 1 and compares against main with a per-metric tolerance."
suites = ["recall@k and MRR over seeded stores at 1k, 10k and 100k events", "activate p50 and p99 cold and warm at 10k and 100k", "continuity: kill -9 mid-turn, restart, resume without duplicate effects", "silent degradation: every forced miss appears in gaps or health", "laundering: no derived record gains observed authority; no Outcome cites a memory; no memory content reaches the system role", "citation validity: quotes lie inside cited frozen ranges", "dream regression: entity, number and quote preservation, drift, duplicate rate, edge precision", "temporal: as-of correctness, supersession, stale-fact rate", "protected types: run writes rejected, proposals surfaced", "attention: suppression precision on a labelled interruption set", "determinism: identical bundle hash on x86-64 and aarch64", "cost: LLM calls, tokens and USD per 1k turns and per run", "LongMemEval, LoCoMo and BEAM with pinned judge and cached responses"]
targets = "At v1.0.0: LongMemEval at least 90 percent, LoCoMo at least 75 percent F1, recall@10 at least 0.95 at 10k, activate p99 under 10 ms at 100k warm, zero lossy rewrites on the dream fixture, zero stale facts stated as current, zero laundering violations, continuity 100 percent, determinism 100 percent, attention precision at least 0.9."

[documentation]
mode = "manual"
status = "pending"
audiences = ["developer", "operator", "user"]
targets = ["README.md", "docs/reference/schematics.md", "docs/adr/**", "docs/concepts/**", "docs/guides/**", "docs/internals/**", "docs/evaluation/**", "docs/security/threat-model.md", "PLAN.md", "HARNESS-LESSONS.md"]
verify_cmd = "mdbook build docs && cargo run -p hm-eval -- docs-gate"

[req.1]
title = "Vertical build discipline"
story = "As the owner, I need the engine built as slices through every layer so that each wave is a working system, never an unproven layer waiting for its consumer."
ac_1 = "Every wave adds to every layer it touches and ends with an integration task whose journey test crosses schema, ledger, projections, indexes, cognition where present, compose, MCP or SDK, restart and recall. Lane tasks in wave N+1 require the integration task of wave N."
ac_2 = "No task delivers behaviour in a crate that no task in the same wave consumes. Empty scaffolding crates from task 1.1 are the only exception. cg spec render and the wave graph reflect this dependency shape."
ac_3 = "Each wave's eval gate is added in that wave and runs in CI before the wave closes."

[req.2]
title = "Ledger durability and idempotency"
story = "As an agent runtime, I need every accepted write to survive any crash and never apply twice."
ac_1 = "Frames carry a 43-byte header and CRC32C; segments use group commit with fdatasync and a manifest; open repairs a torn tail and refuses interior corruption with kInteriorCorruption. The neocortex frame and segment test vectors pass unchanged."
ac_2 = "Append is idempotent by connection id and client sequence with strictly sequential admission; an exact replay returns duplicate; a same-sequence different-digest replay is kIdempotencyConflict; the dedup map rebuilds from envelope metadata at boot; a torn multi-event batch is rolled back at open."
ac_3 = "The fault simulator converges to identical CanonicalBytes over 2,048 schedules including torn writes, reordered completions, lying fsync and kill after every durable LSN; a real fork and SIGKILL test after commit passes."

[req.3]
title = "Sealing, integrity and verification"
story = "As an operator, I need memory encrypted at rest, tamper-evident without keys, and erasable with a receipt."
ac_1 = "Every payload is sealed with XChaCha20-Poly1305 and AAD bound to actor, lsn, kind and user; plaintext on disk is refused; keys are zeroised on close; rotation re-wraps the data key without rewriting the log."
ac_2 = "The MMR leaf commits to the sealed bytes; checkpoints are Ed25519-signed; hm verify audits an actor directory offline with no key and prints the root and LSN; VerifyStatus reports the same online; every append ack returns leaf count, leaf hash and root."
ac_3 = "CryptoDelete writes a signed deletion receipt containing the key fingerprint and root, unlinks the keyring, and a reopen reports kKeyDestroyed. Tripwire LSNs held by the kernel raise a security event on any activation, retract or forget."

[req.4]
title = "Evidence authority and anti-laundering"
story = "As a user, I need the agent to know what was observed, what was asserted and what was inferred, and to be unable to promote one into another."
ac_1 = "Every event and every surfaced item carries one of six authority classes set at ingest from source kind. A derived record is derived_inference unless its text is a verbatim quote of a cited byte range. A model-authored string cannot gain tool_observed by passing through a tool."
ac_2 = "Outcome and LoopClosed done events must cite tool_observed, external_observed or runtime_fact LSNs; citing a memory, summary or reconstruction is rejected at admission. memory.* events are never re-ingested."
ac_3 = "Renderers never place memory content in the system or developer role, drop items without full provenance, exclude same-turn content and raw bytes, and label authority on every item. The laundering suite reports zero violations."

[req.5]
title = "Projections and generations"
story = "As the kernel, I need every read model rebuildable from the log and every consolidation publishable and retractable atomically."
ac_1 = "Each projection applies in one LMDB write transaction that commits mutations and its checkpoint together and requires applied_lsn equals checkpoint plus one; rebuild from any prefix yields byte-identical CanonicalDump; a SIGKILL mid-rebuild resumes from the minimum checkpoint."
ac_2 = "A consolidation run stages derived events under run_id into a generation; publish is a compare-and-swap on active_generation that refuses if any staged record lacks a projection; readers lease a generation for a bounded time; retractions apply to every generation including leased ones; retract switches the pointer back without waiting for cleanup."
ac_3 = "Projections present at v1.0: timeline, lexical, entities, vectors, beliefs, graph, memories, fsrs, intent frame, bindings, work ledger, intentions, attention history, predictions, procedures, attestations, temporal ladder, runs."

[req.6]
title = "Retrieval lanes and planner"
story = "As an agent, I need recall that finds paraphrases, exact identifiers, time windows and connected ideas, and explains why."
ac_1 = "Lexical uses fixed-point BM25 over tantivy postings; vector uses a binary prefilter then int8 dot products with SIMD equal to scalar, flat below 50k and HNSW above with measured recall parity; entity uses exact postings for ids, paths, urls and proper nouns; temporal descends the ladder; graph walks validated edges with validity intervals; belief reads as-of heads."
ac_2 = "The planner classifies query shape deterministically and selects lanes and weights; fusion is reciprocal rank over canonical ids; the composite multiplies fsrs retrievability, salience factor and recency prior; every hit carries a provenance URI with lane ranks and a why code."
ac_3 = "recall@10 is at least 0.95 on the 10k seeded store; recall supports modes semantic, lexical, entity, temporal, graph, asof, timeline and reconstruct, and near for anchored retrieval."

[req.7]
title = "Activation bundle and deadline"
story = "As an agent runtime, I need a budgeted, ordered, explainable context on every turn that never blocks the turn."
ac_1 = "Ten tiers in shed order with resident, intent, bindings and work_ledger required and never shed; exact token counts per target model; trim sheds from the tail and coarsens conversation items before required tiers; if required tiers exceed budget the bundle narrows the subtask and reports a gap."
ac_2 = "The bundle is canonically serialised as HMA1, hashed, pinned to a snapshot epoch, carries a RetrievalManifest with candidates, selected, included and used, plus gaps and health; every provenance LSN yields an Attestation frame."
ac_3 = "activate p99 is under 10 ms at 100k events warm; on a deadline miss it returns the last bundle marked degraded with stale_by_lsn and pushes the fresh bundle over Subscribe; the silent-degradation suite shows every forced miss in gaps or health."

[req.8]
title = "Beliefs and time"
story = "As a user, I need the agent to know what was true when, what it knew when, and to surface contradictions unprompted."
ac_1 = "Beliefs are versioned with supersedes chains, conflict edges with obligated surfacing, and as-of queries by valid_at or known_at that can return different answers; records are tri-temporal with event_time_ns, observation LSN and validity."
ac_2 = "The admission gate rejects negative_existence without a corroborating tool_observed LSN and lists same-domain conflicts before commit; identity, constraint and preference accept Assertion and Retract only from user or admin authority; runs emit ProposedAssertion surfaced in the conflicts tier."
ac_3 = "dispute runs in-process NLI both directions, escalates genuine to one tier-capped LLM supersession check, and yields Retract plus Assertion or a conflict edge; the temporal suite reports zero stale facts stated as current."

[req.9]
title = "Consolidation as retractable generations"
story = "As a user, I need the agent to consolidate what it learns without ever corrupting what it knew, and to undo any consolidation."
ac_1 = "NREM clusters without an LLM and makes one structured-output call per cluster; REM connects from adjacency with one long-context pass, abstracts with novelty and grounding gates, and audits with hindsight defaulting to no change; every derived record carries run_id, model_provenance and citations."
ac_2 = "Every quoted span in a derived record lies inside a cited byte range in the run's frozen candidate set or the candidate is dropped and counted; mint requires at least three independent source roots from at least two conversations; derived authority is derived_inference."
ac_3 = "Runs declare max_llm_calls, max_tokens, max_usd and max_wall_ms and abort cleanly on any; phases persist with a per-attempt idempotency prefix and resume after a crash; consolidate retract switches activation back immediately; the dream regression fixture shows zero lossy rewrites."

[req.10]
title = "Retention and forgetting"
story = "As a user, I need the agent to forget noise and never forget what it is standing on."
ac_1 = "FSRS-6 orders review from attestations, retrieval rank and contradiction involvement; dreams do not count as access."
ac_2 = "Retention class in current_state, daily, durable, do_not_store decides eligibility; do_not_store writes nothing; the protection set excludes provenance of open loops, active bindings, unfulfilled intentions, resident beliefs and the last N bundles; the last K contradicted outcomes per domain are kept as counterexamples."
ac_3 = "Fading is an event; faded memories are excluded from refine, connect, abstract and sampling; nothing is deleted except by crypto-shred or an explicit retract."

[req.11]
title = "Prospective memory and attention"
story = "As a user, I want the agent to follow up on its own, and to know when not to interrupt me."
ac_1 = "IntentionSet accepts the wake-trigger vocabulary; triggers are persisted before the action waits; IntentionFired carries a stable wake id so duplicate external events resume once."
ac_2 = "Every fired intention is scored by the attention function with quiet hours, notification budget and workload applied and recorded as AttentionDecided with a readable reason; only notify, ask_user and start_work reach the prospective tier; batch produces a digest item; schedule re-arms."
ac_3 = "The attention history is a bounded projection the user can inspect; attention suppression precision on the labelled set is at least 0.9."

[req.12]
title = "Predictions and procedures"
story = "As a user, I want the agent to say what it expects, notice when it was wrong, and get better at things it has done before."
ac_1 = "Predicted carries bounded predicates from the fixed vocabulary and a deadline; OutcomeObserved assesses supported, contradicted, pending, unresolvable or not_executed with observation LSNs; calibration is reported per predicate kind; a revision_required gap follows three same-mechanism failures."
ac_2 = "Procedures are mined from ToolCall to ToolResult to Effect to Outcome chains per closed loop; supported requires three independent source roots from two conversations; adopted requires a user-authority event; only adopted procedures render as instructions, tentative ones render as observations."
ac_3 = "Model narrative cannot redefine success after results; assessments cite observation LSNs only."

[req.13]
title = "Surfaces"
story = "As an integrator, I need one protocol locally and remotely, thirteen composable tools, a REST mirror and a CLI."
ac_1 = "The Unix socket speaks NCPR framing byte-compatible with neocortex proto_version 2 and adds v3 requests; gRPC over mTLS carries the same envelope bytes with streaming Subscribe; admin and actor tokens are disjoint and never mix on a connection."
ac_2 = "MCP exposes exactly the thirteen verbs with the one envelope; every mutation error carries effect_state; resources resolve hm:// URIs; a prompt exposes the activate-backed system block; REST mirrors the verbs with OpenAPI and gates destructive verbs on the admin token."
ac_3 = "hm covers init, serve, doctor, actor management, remember, recall, activate, consolidate, verify, bench, export, import and tui; every command takes --json."

[req.14]
title = "SDKs and migration"
story = "As a developer, I need HyperMind from Rust, TypeScript, Python and Go with one contract, and a path off cortex-engine."
ac_1 = "The Rust crate is the kernel with an embedded API; TypeScript ships engine via napi prebuilds, client over gRPC and mcp; Python ships hypermind via maturin wheels and a gRPC client; the Go client keeps its sequence-recovery state machine and gains Recall, AsOf, Subscribe and CryptoDelete builders; all pass their suites against the real daemon."
ac_2 = "Every SDK exposes Session, remember, recall, activate to Bundle, render, attest, believe, intend, bind, predict, outcome and consolidate with the same envelope and error codes; every mutation error carries effect_state; renderers enforce activation safety."
ac_3 = "migrate-from-cortex imports a cortex-engine SQLite or JSON store into events with authority user_asserted for observations and derived_inference for dream-minted memories, preserves ids and edges, and verifies counts and a sample of embeddings."

[req.15]
title = "Evaluation gate and targets"
story = "As the owner, I need every quality claim to be a number produced in CI."
ac_1 = "hm-eval runs the internal suites and the public benchmarks, writes JSON to eval/results, compares against main with per-metric tolerance, and fails CI on regression; judge models are pinned and responses cached by content hash; judge-free and judged metrics are reported separately."
ac_2 = "Wave 8 publishes LongMemEval at least 90 percent, LoCoMo at least 75 percent F1, recall@10 at least 0.95 at 10k, activate p99 under 10 ms at 100k warm, zero lossy rewrites, zero stale facts, zero laundering violations, continuity 100 percent, determinism 100 percent across x86-64 and aarch64, attention precision at least 0.9, and cost per 1k turns."
ac_3 = "A hash-feature embedder is labelled lexical_only in every report; no metric is blended across encoders or judges."

[req.16]
title = "Documentation and packaging"
story = "As an adopter, I need to add memory to any MCP client in two commands and understand what it does."
ac_1 = "docs contain start-here, concepts, guides, reference (schematics rewritten from the schema, protocol, MCP, CLI, config, prompts, SDKs), internals, evaluation, security and ADRs; every public type and tool carries when-to-use and do-not-use; the docs gate passes."
ac_2 = "Packaging ships a distroless static image, compose, systemd unit and Helm chart; models download on first run with pinned digests; hm doctor reports what is present; release builds are reproducible."

[req.17]
title = "Multi-actor isolation and budgets"
story = "As an operator, I need many agents in one daemon without leakage and with bounded cost."
ac_1 = "Actors have separate keys, logs, LMDB environments and vector lanes; one writer task per actor; cross-actor reads happen only through bridges that append origin_actor events or a read-only commons actor."
ac_2 = "Per-connection output queues are bounded and a saturated subscriber is disconnected; consolidation runs per actor under declared budgets; cost is accounted per operation and reported."

[task.1.1]
title = "Workspace, core ids and errors, CI, and empty scaffolding for every crate"
status = "done"
wave = 1
section = "Wave 1 — Spine: remember and recall one thing, end to end"
owner_lane = "root-foundation"
requires = []
reqs = ["1.2", "1.3"]
touches = ["Cargo.toml", "rust-toolchain.toml", "deny.toml", ".github/workflows/**", "crates/hm-core/**", "crates/*/Cargo.toml", "crates/*/src/lib.rs", "README.md", ".gitignore"]
verify_cmd = "cargo build --workspace && cargo clippy --workspace -- -D warnings && cargo test -p hm-core"
do_1 = "Create the Cargo workspace with hm-core, hm-schema, hm-ledger, hm-proj, hm-index, hm-embed, hm-llm, hm-cortex, hm-compose, hm-serve, hm-mcp, hm-cli, hm-sim, hm-eval as crates; later-wave crates contain only lib.rs and a version constant."
do_2 = "Implement hm-core: EntityId, LSN, ActorId, ConversationId (16 bytes derived as in the Go client), SchemaVersion, UtcNanos, the full ErrorCode enum carrying every neocortex code plus kProtectedTypeWrite, kCitationInvalid, kDeadlineMissed, kTripwire, and Error with system_error, lsn and offset."
do_3 = "CI: build, clippy with warnings denied, fmt, cargo-deny, test on x86-64 and aarch64 runners; a bench-gate job that runs hm-eval gate for the current wave and compares to main."

[task.1.2]
title = "Schema v2 subset and protocol v3 subset with generated code and validation"
status = "done"
