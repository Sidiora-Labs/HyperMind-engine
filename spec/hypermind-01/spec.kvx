do_2 = "Generate Rust with planus; implement VerifyEvent and VerifyRequest that fail closed on unknown versions, missing required fields, unknown union members and ToolResult without a prior ToolCall reference."
do_3 = "Carry the neocortex schema_test and protocol fuzz seed corpus as fixtures; a v1 Go-client envelope decodes as v2 with defaults."

[task.1.3]
title = "Frame codec, segment log and sealing"
status = "done"
wave = 1
owner_lane = "ledger"
requires = ["1.1"]
reqs = ["2.1", "3.1"]
touches = ["crates/hm-ledger/src/frame.rs", "crates/hm-ledger/src/segment.rs", "crates/hm-ledger/src/seal.rs", "crates/hm-ledger/src/keyring.rs", "crates/hm-ledger/tests/frame.rs", "crates/hm-ledger/tests/segment.rs", "crates/hm-ledger/tests/seal.rs", "crates/hm-ledger/fixtures/**"]
verify_cmd = "cargo test -p hm-ledger"
do_1 = "Port frame.h and frame.cc: 43-byte header, CRC32C over lsn onward, 16 MiB maximum; the neocortex frame test vectors pass byte for byte."
do_2 = "Port segment_log: numbered 128 MiB segments, NCMF manifest, group commit into one 4096-aligned buffer with fdatasync then manifest rewrite then directory fsync, torn-tail truncation on open, kInteriorCorruption refusal, manifest rebuild; pwrite backend now, io_uring behind a feature flag."
do_3 = "Port sealing: KEK to user key to data key wrapped with XChaCha20-Poly1305, NCKEY001 keyring, NCSEAL01 record layout, AAD bound to actor, lsn, kind and user, kLegacyPlaintext on unsealed records, zeroize on drop; the plaintext BLAKE3 digest is stored inside the sealed record for wave 3."

[task.1.4]
title = "LMDB projection store with checkpointed apply, timeline and lexical projections"
