do_1 = "Port mmr.cc and mmr/store.cc with domain-separated BLAKE3, RootAt, ProveRange and VerifyRange; the leaf commits to header plus sealed payload; the neocortex mmr_test vectors are regenerated once for the sealed-leaf change and frozen."
do_2 = "Ed25519-signed checkpoints under mmr/checkpoints; hm verify actor-dir actor checkpoint pubkey prints MEMORY VERIFIED root and lsn with no key material; VerifyAndRepairBounded on open appends missing leaves in 1024-frame batches."
do_3 = "Crypto-shred writes DELETION_RECEIPT with key fingerprint and root, unlinks the keyring, zeroises, reopen reports kKeyDestroyed; RotateKeys re-wraps the data key under a new KEK; tripwire set is seeded at init and held in kernel memory keyed by LSN."

[task.3.2]
title = "Authority enforcement at ingest, derivation rule, citation invariants, sensitivity and retention"
status = "done"
wave = 3
owner_lane = "cognition"
requires = ["2.8"]
reqs = ["4.1", "4.2", "10.2"]
