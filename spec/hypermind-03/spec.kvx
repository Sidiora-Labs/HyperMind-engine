verify_cmd = "cargo test -p hm-context --test cache"
acceptance = "Frozen baseline, recent delta and live tail; exact byte replay; scope/model/policy/source identity fences; hard and soft folds; pending reductions; immediate invalidation for revoked access or corrected required evidence; atomic checkpoint restoration."
qualification = "Implementation and focused component checks passed; integrated consumer and release qualification are recorded separately."

