acceptance = "All accepted knowledge and context mutations use ledger events and rebuildable projections; migration preserves revisions, tombstones, sharing scope, time and provenance; durable job reconciliation does not hide partial commits."

qualification = "Native import and memory migration tests passed six real cases, including revisions, restart, staged visibility, canonical JSON Lines, optimistic conflicts, malformed sharing refusal and nested authority escalation refusal. Source-history adapter qualification is tracked in task.2.14; physical purge and cutover remain later obligations."

