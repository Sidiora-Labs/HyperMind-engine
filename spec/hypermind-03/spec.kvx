[meta]
feature = "hypermind-03"
title = "Unified agent context, memory and module runtime"
status = "in_progress"
spec_version = "1.0.0"

[design.authority]
contract = "HyperMind is the canonical engine. The event ledger remains the authority for durable memory; context, indexes and caches are derived. Host transcripts remain authoritative inputs with immutable source identities. Operational job and process stores never become independent memory authorities."
compatibility = "Preserve the hypermind-01 and hypermind-02 contracts. Hypermid compatibility is explicit and versioned. Existing accepted wire discriminants and event meanings remain stable. Existing qualification limitations are not cleared by this feature."

[design.context]
contract = "A session assembles immutable source history, frozen context regions, required live bindings and retrieved evidence into one provider-safe budget. Original source bytes remain recoverable. Required freshness and access changes invalidate affected cache entries before serving."
types = "crates/hm-context/src/types.rs defines the shared version-1 scope, cursor, source message, source span, token budget and context report. Actor identifiers are locally assigned and never derived by truncating external identities."

[design.background]
contract = "History summarization and durable memory consolidation are distinct, coordinated background jobs. Every job has a frozen source set, identity-bound cursor, fenced attempt and budget. Derived text is never automatically admitted as fresh observation. Publication checks source and policy revisions."

[design.integration]
contract = "One scoped context owner per session and one memory authority per actor. Public embedded APIs, daemon surfaces, SDKs and the inspection console consume the same contracts. User memory is never rendered as system or developer authority. Existing fourteen tool verbs remain stable."

[design.migration]
contract = "Import is resumable and digest verified, retains source identities and revisions, and writes through the existing ledger admission path. Cutover occurs at a quiescent boundary with durable progress. Rollback retains accepted post-cutover writes; an unsupported backward mapping requires forward recovery rather than data loss."

[design.delivery]
contract = "Wave 1 delivers interoperable context, worker and migration components plus their existing-surface consumer. Wave 2 closes durable ledger integration and source/SDK parity. Wave 3 closes deep memory and worker behaviors. Wave 4 qualifies complete user journeys and comparative evaluation. A component gate alone does not establish integration or release qualification."

[design.coverage]
contract = "spec/hypermind-03/capabilities.kvx is the complete capability acceptance map. Its coverage and deep memory requirements refine the wave tasks. A wave cannot claim complete parity while any assigned requirement remains unimplemented or unqualified."

[req.1]
title = "Immutable conversation history and source recovery"
acceptance = "Ordered validated source ingestion, idempotent replay, edits and tombstones as relations, scope-bound source recovery, frozen child snapshots, and canonical export/import without rewriting original bytes."

[task.1.1]
title = "Immutable conversation history and source recovery"
wave = 1
owner_lane = "history"
status = "done"
requires = []
reqs = ["req.1"]
touches = ["crates/hm-context/src/history.rs", "crates/hm-context/tests/history.rs"]
verify_cmd = "cargo test -p hm-context --test history"
acceptance = "Ordered validated source ingestion, idempotent replay, edits and tombstones as relations, scope-bound source recovery, frozen child snapshots, and canonical export/import without rewriting original bytes."
qualification = "Implementation and focused component checks passed; integrated consumer and release qualification are recorded separately."

[req.2]
title = "Stable context generations and cache invalidation"
acceptance = "Frozen baseline, recent delta and live tail; exact byte replay; scope/model/policy/source identity fences; hard and soft folds; pending reductions; immediate invalidation for revoked access or corrected required evidence; atomic checkpoint restoration."

[task.1.2]
title = "Stable context generations and cache invalidation"
wave = 1
owner_lane = "cache"
status = "done"
