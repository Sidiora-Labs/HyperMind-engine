current_paths = ["crates/hm-context/src/notes.rs", "crates/hm-context/src/maintenance.rs", "crates/hm-context/src/historian.rs", "crates/hm-cortex/src"]
acceptance = "Categorize durable project rules, architecture decisions, constraints, configuration and naming conventions with owner scope and source authority. Active, pinned and archived states have explicit injection/curation semantics. Track observed retrieval/use separately from importance, trim injection deterministically under budget and suppress already-visible evidence without hiding exact search recovery."
remaining = "Foundational records and scheduler APIs do not implement the complete evidence-consuming worker and host review journey. Ledger publication, real bounded workers and visible consumer evidence are required."

[design.coverage_closure]
contract = "A capability closes only when its independent acceptance and all linked coverage/deep requirements pass through a declared executable consumer. Where related code implements only a subset, preserve the remaining gap rather than promoting the component status to full completion."
wave2 = "task.2.1 closes authority, revision/lineage migration and derived invalidation; task.2.2 closes installed OSS Gideon and Rust/Python/TypeScript/Go/Swift consumers; task.2.3 closes real multi-source retrieval, embeddings and indexing. task.2.4 requires those consumers together."
wave3 = "task.3.1 closes every deep knowledge requirement with real evidence workers and review surfaces; task.3.2 closes PostgreSQL/NATS backend parity, role conformance, strong process containment, catalog/usage/push/logging, signed registry lifecycle, service management and optional federated/mobile routing; task.3.3 closes long-session provider and modality continuity. task.3.4 joins these real executable paths."
wave4 = "task.4.1 measures quality/cost/continuity on pinned workloads, task.4.2 closes native host, browser, desktop/mobile and accessibility journeys, and task.4.3 closes declared platform/SDK/backend/security matrices and reversible cutover. A platform or provider absence remains an explicit gap."
unsupported_policy = "Current unsupported containment is an implementation obligation under task.3.2, not a completed compatibility decision. Runtime negotiation must advertise it as unavailable until implemented and qualified. Optional remote/backends remain unavailable until explicitly enabled and proven."
