acceptance = "Map claims to concrete authorized file/repository/source evidence or an explicit source-independent classification. Store the evidence identity, revision and digest used for each mapping. New records enter a bounded mapping backlog; moved or deleted sources invalidate the mapping rather than broadening access."
remaining = "Foundational records and scheduler APIs do not implement the complete evidence-consuming worker and host review journey. Ledger publication, real bounded workers and visible consumer evidence are required."

[req.deep.incremental_verification]
status = "pending"
tasks = ["task.3.1"]
current_paths = ["crates/hm-context/src/notes.rs", "crates/hm-context/src/maintenance.rs", "crates/hm-context/src/historian.rs", "crates/hm-cortex/src"]
acceptance = "Recheck only records whose mapped evidence changed since that individual record was verified. Compare actual current source contents and preserve supported, contradicted and unresolved findings with cited spans. Corrections require optimistic publication fences; a classifier or prior summary cannot serve as fresh observation."
remaining = "Foundational records and scheduler APIs do not implement the complete evidence-consuming worker and host review journey. Ledger publication, real bounded workers and visible consumer evidence are required."

[req.deep.complete_verification]
status = "pending"
tasks = ["task.3.1"]
current_paths = ["crates/hm-context/src/notes.rs", "crates/hm-context/src/maintenance.rs", "crates/hm-context/src/historian.rs", "crates/hm-cortex/src"]
acceptance = "Persist a complete verification cycle over the authorized mapped pool, independent of incremental change detection. Bound each run and checkpoint unfinished records so timeout, cancellation and restart resume the same cycle. Preserve competing evidence and report incomplete coverage rather than claiming the highest completed cursor proves continuity."
remaining = "Foundational records and scheduler APIs do not implement the complete evidence-consuming worker and host review journey. Ledger publication, real bounded workers and visible consumer evidence are required."

[req.deep.curation]
status = "pending"
