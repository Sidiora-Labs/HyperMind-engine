[req.deep.anchored_knowledge]
status = "pending"
tasks = ["task.2.1", "task.3.1"]
current_paths = ["crates/hm-context/src/notes.rs", "crates/hm-context/src/maintenance.rs", "crates/hm-context/src/historian.rs", "crates/hm-cortex/src"]
acceptance = "Record immutable chronological observations separately from mutable conclusions. Preserve occurrence time versus record time, exact source spans, authority, confidence and contradiction groups. Corrections append relationships and new revisions; summaries and decay never rewrite anchors. Concurrent expected-revision writes yield one accepted mutation and one conflict with no partial derivative state."
remaining = "Foundational records and scheduler APIs do not implement the complete evidence-consuming worker and host review journey. Ledger publication, real bounded workers and visible consumer evidence are required."

[req.deep.source_mapping]
status = "pending"
tasks = ["task.3.1"]
