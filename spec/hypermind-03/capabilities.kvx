[meta]
feature = "hypermind-03"
title = "Complete capability coverage and qualification obligations"
status = "in_progress"
schema_version = 1
public_map_entries = 149
authority = "The HyperMind event ledger is the durable memory authority. Public Hypermid capabilities are mapped by identifier; this inventory does not claim compatibility or completion merely from source presence."
status_contract = "implemented_focused means a bounded component exists with focused evidence, not complete capability acceptance; integration_pending means related code exists but full behavior or consumers remain incomplete; pending means implementation or qualification remains required; unsupported means current runtime explicitly lacks the behavior and cannot report success."
task_contract = "Main task IDs refer to spec.kvx. Requirements here refine those tasks and do not start, claim or complete them. Every capability is closed only when its requirement and declared real consumer evidence pass."

[req.coverage.identity]
status = "integration_pending"
tasks = ["task.2.1"]
current_paths = ["crates/hm-context/src/types.rs", "crates/hm-fabric/src/storage.rs"]
acceptance = "Canonical existing roots retain worktree separation; recovery-only identities cannot publish. Persist external owner and project mappings without narrowing them into local actor identifiers. Concurrent writers use monotonically increasing fences and stale fences commit nothing."
remaining = "Cross-platform aliases and all executable admission paths still require integration evidence."

[req.coverage.storage]
status = "implemented_focused"
tasks = ["task.2.1", "task.3.36", "task.3.2"]
current_paths = ["crates/hm-ledger/src/lib.rs", "crates/hm-fabric/src/storage.rs", "crates/hm-fabric/src/backend_config.rs", "crates/hm-fabric/src/backend_runtime.rs", "crates/hm-fabric/src/effects.rs"]
acceptance = "The event ledger owns durable memory. Operational descriptors omit administrator secrets, bind backend and isolation, and declare home resolution. SQLite schema changes are ordered, checksum checked and transactional; newer unsupported state opens a documented recovery path."
remaining = "Selected SQLite and PostgreSQL owners now retain operational records, results and effects; actual worker and PostgreSQL crash/reopen gates passed. Network interruption during commit, broader platform coverage and aggregate release qualification remain pending."

[req.coverage.postgres]
status = "pending"
tasks = ["task.3.2"]
current_paths = ["crates/hm-fabric/src/storage.rs"]
acceptance = "Implement PostgreSQL operational storage against pre-provisioned databases using session locks, monotonic write fences and namespace migrations. Connection loss ends liveness; colliding display names cannot share physical databases. Keep durable memory authority in the ledger."
remaining = "No PostgreSQL driver or real backend consumer is present in the new storage component."

[req.coverage.history]
status = "integration_pending"
tasks = ["task.2.1", "task.3.3"]
current_paths = ["crates/hm-context/src/history.rs", "crates/hm-serve/src/context_history.rs"]
acceptance = "Ingest a complete validated source batch atomically with stable identities, source digests, ordering and scoped cursor checks. Edits, deletion relations, retries and child snapshots preserve original bytes. Exact recovery checks source spans against authoritative content after restart."
remaining = "Full host variants, migration revisions and long-session recovery remain integration obligations."

[req.coverage.cache]
requires_acceptance = ["req.deep.compact_memory_cues"]
status = "implemented_focused"
tasks = ["task.3.3"]
current_paths = ["crates/hm-context/src/cache.rs", "crates/hm-serve/src/context_projection.rs"]
acceptance = "Persist complete generations with source, policy, permission, provider and budget fences. Deferred passes reuse identical prefix bytes; new summaries apply only at compatible boundaries. Changed required evidence invalidates eligibility before serving; corrupt derived state rebuilds from the ledger."
remaining = "Focused cache behavior does not establish long-session or host provider continuity."

[req.coverage.reduction]
status = "implemented_focused"
tasks = ["task.3.3"]
current_paths = ["crates/hm-context/src/reduction.rs"]
acceptance = "Protect current work, output reserve and tool dependencies before age-based selection across four detail tiers. Every reduction has a stable target, explicit disposition and exact expansion reference. Pressure plans are deterministic; irreducible overflow prevents dispatch."
remaining = "Live provider continuity, multimodal tools and complete recovery-marker journeys are pending."

[req.coverage.historian]
requires_acceptance = ["req.deep.source_mapping", "req.deep.incremental_verification", "req.deep.complete_verification", "req.deep.curation", "req.deep.classification_and_sharing", "req.deep.retrospective_lessons", "req.deep.profile_review", "req.deep.primer_development", "req.deep.primer_refresh", "req.deep.documentation_proposals", "req.deep.knowledge_schedules"]
status = "integration_pending"
tasks = ["task.3.1", "task.3.3"]
current_paths = ["crates/hm-context/src/historian.rs", "crates/hm-context/src/maintenance.rs", "crates/hm-serve/src/context_jobs.rs"]
acceptance = "One fenced attempt operates on a frozen source set with bounded calls, time and usage. Publish only structurally valid nonempty output matching current source and policy. Cancellation, timeout and source changes reject publication; usage remains separate from foreground turns."
remaining = "Real background model execution and complete knowledge publication have not been demonstrated by component scheduling gates."

[req.coverage.provider]
status = "implemented_focused"
tasks = ["task.2.2", "task.3.3"]
current_paths = ["crates/hm-context/src/provider.rs", "crates/hm-llm/src/contract.rs"]
acceptance = "Provider-neutral blocks preserve roles, opaque parts and paired tool calls under exact input and output budgets. Capability changes produce a fresh generation; unsupported serializers or tokenizers refuse before model dispatch. Host serialization returns verifiable bytes and digest."
remaining = "Complete provider family and installed host serializer parity remains pending."

[req.coverage.hooks]
status = "integration_pending"
tasks = ["task.2.2", "task.3.3"]
current_paths = ["crates/hm-fabric/src/roles.rs", "crates/hm-context/src/history.rs"]
acceptance = "Child sessions receive immutable scoped parent snapshots under an explicit contribution ceiling. Pre-hooks may deny or contribute bounded attributed blocks but cannot mutate source history; failed pre-hooks leave no partial effects. Post-hooks observe only committed state with trace and cursor metadata."
remaining = "All host lifecycle hooks, child usage attribution and contribution flows need installed integration."

[req.coverage.context_mode]
status = "integration_pending"
tasks = ["task.2.2", "task.3.46", "task.4.3"]
current_paths = ["crates/hm-serve/src/context_config.rs", "crates/hm-serve/src/session_context.rs", "crates/hm-serve/src/continuity_service.rs", "sdk/python/hypermind/continuity_host.py"]
acceptance = "Off and pass-through retain existing host provider input. Shadow compares derived results without publishing, model calls or serving-cursor advance. Primary dispatch requires a verified projection or explicit policy refusal. Independent feature flags change only at turn boundaries."
remaining = "The installed host preserves off/pass-through bytes and qualifies read-only shadow comparison with boundary policy changes. Hosts without failure-refusing hooks reject primary mode. Primary host serving, cancellation and all turn variants remain unqualified."

[req.coverage.diagnostics]
status = "integration_pending"
tasks = ["task.4.2"]
current_paths = ["crates/hm-serve/src/session_context.rs", "crates/hm-serve/src/telemetry.rs", "sdk/typescript/packages/console/src/context.ts"]
acceptance = "Report scoped source cursors, generations, budgets, cache decisions, jobs, module state, typed errors and recovery eligibility with observation times. Default output omits content and secrets; absent measurements remain unknown, unavailable or degraded rather than zero."
remaining = "Native console and host failure journeys have not closed the inspection matrix."

[req.coverage.migration]
requires_acceptance = ["req.deep.retention_and_purge"]
status = "integration_pending"
tasks = ["task.2.1", "task.4.3"]
current_paths = ["crates/hm-serve/src/hypermid_import.rs", "crates/hm-cli/src/lib.rs"]
acceptance = "Stage bounded versioned imports, verify manifest digests, preserve revisions, scope grants, timestamps and provenance, then publish idempotently. Canonical export excludes secrets and disposable derivatives. Cutover drains writers; rollback preserves accepted post-cutover writes or requires explicit forward recovery."
remaining = "Complete record families, retention, encrypted backup and cutover crash matrix remain pending."

[req.coverage.notes]
requires_acceptance = ["req.deep.anchored_knowledge", "req.deep.cross_session_memory", "req.deep.deferred_notes", "req.deep.profile_review", "req.deep.retention_and_purge"]
status = "implemented_focused"
tasks = ["task.2.1", "task.3.1"]
current_paths = ["crates/hm-context/src/notes.rs", "crates/hm-serve/src/context_jobs.rs"]
acceptance = "Anchors keep original content; notes and primers require expected revisions. Tombstones and retention exclude expired content without silently purging protected evidence. Lineage is acyclic and contradictions retain competing evidence. Conditional evaluation is bounded; protected user attributes require a proposal and owner decision."
remaining = "Chronological anchor provenance and complete dependent-index invalidation remain pending integration requirements."

[req.coverage.retrieval]
requires_acceptance = ["req.deep.cross_session_memory", "req.deep.classification_and_sharing"]
status = "implemented_focused"
tasks = ["task.2.3"]
current_paths = ["crates/hm-context/src/retrieval.rs", "crates/hm-index/src/bm25.rs", "crates/hm-index/src/hnsw.rs"]
acceptance = "Search authorized memory, messages, files, commits, documents and relations through deterministic lexical, semantic or hybrid ranking. Filter source time and stale or tombstoned content; suppress evidence already visible by exact coverage. Explain scores, provenance, unavailable vectors and bounded reranking."
remaining = "Typed fusion exists; complete real index and embedding provider consumers remain pending."

[req.coverage.embedding]
status = "integration_pending"
tasks = ["task.2.3"]
current_paths = ["crates/hm-embed/src/local.rs", "crates/hm-embed/src/remote.rs", "crates/hm-context/src/retrieval.rs"]
acceptance = "Declare off, local, remote-compatible and managed embedding modes. Model, dimensions, registration and content fingerprints fence every vector. Reject non-finite or zero-norm vectors and model substitution; bounded backfill resumes checkpoints without replacing valid vectors on failure."
remaining = "Provider registration lifecycle and all bounded backfill failure classes require integration."

[req.coverage.indexing]
requires_acceptance = ["req.deep.source_mapping", "req.deep.retention_and_purge"]
status = "integration_pending"
tasks = ["task.2.3"]
current_paths = ["crates/hm-cortex/src/repograph.rs", "crates/hm-cortex/src/connectors/sync.rs", "crates/hm-context/src/retrieval.rs"]
acceptance = "Index raw messages, authorized canonical files and opt-in repository commits under byte, item and time limits. Recheck source identity, digest and grants immediately before publication; a source correction hides stale lexical, vector and ranking derivatives in the same accepted mutation."
remaining = "Predicate-driven file indexing, opt-in commit ingestion and atomic derivative invalidation are not fully connected."

[req.coverage.auth]
status = "integration_pending"
tasks = ["task.2.1", "task.3.2"]
current_paths = ["crates/hm-serve/src/auth.rs", "crates/hm-context/src/notes.rs", "crates/hm-context/src/retrieval.rs"]
acceptance = "Authorize each operation by principal, owner, project, optional workspace, exact resource, revision and expiry. Worker grants enumerate inputs and writes and cannot be widened. Revocation blocks dispatch and publication; workspace membership alone never authorizes foreign mutation."
remaining = "Uniform expiring principal and worker capabilities across transport, ledger and operational modules remain pending."

[req.coverage.transport]
status = "implemented_focused"
tasks = ["task.2.2", "task.3.2"]
current_paths = ["crates/hm-fabric/src/transport.rs", "crates/hm-serve/src/grpc/tls.rs"]
acceptance = "Validate bounded frames before body allocation and authenticate protocol, daemon identity, nonces and connection class. Remote operation is opt-in with mutually authenticated encryption. Negotiate version and feature ranges without downgrade; reject replay or incompatible peers before effects."
remaining = "Hypermid framing compatibility and complete remote transport/certificate qualification remain pending."

[req.coverage.routing]
status = "implemented_focused"
tasks = ["task.3.2"]
current_paths = ["crates/hm-fabric/src/routing.rs", "crates/hm-fabric/src/runtime.rs"]
acceptance = "Validate module identity, digest, dependency, policy and launch proof before registration. Publish routes only after authenticated binding; epoch changes retire old frames. Request and byte credits remain independent and bounded; cancellation and deadline races settle once without extending the original deadline."
remaining = "Complete declared module discovery, flow behavior and crash-driven host routes require integration."

[req.coverage.supervisor]
status = "implemented_focused"
tasks = ["task.3.2"]
current_paths = ["crates/hm-fabric/src/supervisor.rs"]
acceptance = "Clear child environments, bound stderr and readiness, preserve a healthy incumbent on failed warmup and drain before retirement. Cap restart windows and exponential backoff. Declare direct-child and stronger containment capabilities separately and never advertise unavailable process-tree or resource isolation."
remaining = "Current implementation manages direct children; process-tree termination, resource limits and filesystem isolation are unsupported."

[req.coverage.containment]
status = "unsupported"
tasks = ["task.3.2", "task.4.3"]
current_paths = ["crates/hm-fabric/src/supervisor.rs"]
acceptance = "Implement platform process-tree ownership with stable launch identity, bounded CPU and memory resources and explicit filesystem/network grants. Recovered daemons cannot terminate a reused PID. Interruption reaps descendants without orphaned pipes; unsupported platforms refuse restricted launches."
remaining = "Process-tree termination, resource limits and filesystem isolation are currently false in containment capabilities."

[req.coverage.effects]
status = "implemented_focused"
tasks = ["task.3.2", "task.4.3"]
current_paths = ["crates/hm-fabric/src/effects.rs", "crates/hm-ledger/src/idempotency.rs"]
acceptance = "Persist intent before dispatch and terminal outcome before acknowledgement. Reused effect IDs must match input digests; recovery distinguishes not-started, committed and unknown. Cancel or disconnect never converts uncertainty into a retryable failure or blindly repeats durable mutation."
remaining = "Executable multi-process crash and host delivery journeys remain pending."

[req.coverage.bus]
status = "implemented_focused"
tasks = ["task.3.2"]
current_paths = ["crates/hm-fabric/src/bus.rs", "crates/hm-fabric/src/runtime.rs"]
acceptance = "Scope stream names and exact grants; retain durable replay positions, attempt-fenced acknowledgements, redelivery, dead letters and revisioned registers. Queue and payload limits fail visibly; revocation precedes serving. Operational delivery storage never becomes another memory authority."
remaining = "Only SQLite operational delivery is implemented; a distinct process-local backend, all six public naming families, census guards, digest-only messages and distributed parity remain pending."

[req.coverage.nats]
status = "pending"
tasks = ["task.3.2"]
current_paths = ["crates/hm-fabric/src/bus.rs"]
acceptance = "Connect to provisioned NATS/JetStream with bounded isolated inboxes, durable stream cursors, acknowledgements, redelivery, dead letters and revisioned registers. Server-enforced allow-only grants reflect local scope and revocation; reconnect exposes cursor gaps rather than silent loss."
remaining = "No NATS or JetStream backend exists in the current bus component."

[req.coverage.roles]
status = "implemented_focused"
tasks = ["task.3.2"]
current_paths = ["crates/hm-fabric/src/roles.rs", "crates/hm-fabric/src/runtime.rs"]
acceptance = "Tool, model-runner, compaction and transform roles negotiate schemas and semantic digests, explicit capability operations, ordered hooks and bounded replacements. Late results require acknowledgement; held work withdraws safely. Each role runs through authenticated local routes."
remaining = "Complete real-provider conformance, crash points and all negotiated role operations remain pending."

[req.coverage.role_conformance]
status = "pending"
tasks = ["task.3.2", "task.4.3"]
current_paths = ["crates/hm-fabric/tests/roles.rs", "crates/hm-fabric/tests/runtime.rs"]
acceptance = "Use real role executables and providers on fresh state roots, record a committed point, terminate the process and resume through the same authenticated route. Verify approvals, catalogs, late delivery, compaction fences and cancellation; capability absence is a skip or failure, never a pass."
remaining = "Component dispatch tests are not the complete live-provider role conformance matrix."

[req.coverage.catalog]
status = "pending"
tasks = ["task.3.2"]
current_paths = ["crates/hm-llm/src/registry.rs", "crates/hm-llm/src/cost.rs"]
acceptance = "Load external model catalogs with provider capabilities, modality limits, context ceilings and exact tiered integer prices. Preserve unknown additive metadata, reject malformed prices and expose catalog generation and readiness without fabricated bundled values."
remaining = "Existing provider registry does not establish complete external catalog and price contract parity."

[req.coverage.usage]
status = "integration_pending"
tasks = ["task.3.34", "task.3.45", "task.3.2"]
current_paths = ["crates/hm-llm/src/provider_usage.rs", "crates/hm-serve/src/usage_service.rs", "crates/hm-serve/src/development_usage.rs", "crates/hm-fabric/src/role_runner.rs"]
acceptance = "Preserve quota windows, refill timing, balances, token/cache categories, funding provenance, account scope, staleness and in-band errors. Reserve foreground and background cost and concurrency before dispatch; unknown charges stay reserved until reconciled. Store per-turn attribution for host rollups."
remaining = "Original historian, extraction and authenticated runner observations settle existing reservations once and retain unknown holds across restart. Generic worker capture, account-wide quota coverage, public exact rollups and complete model-budget consumers remain pending."

[req.coverage.push]
status = "pending"
tasks = ["task.3.2"]
current_paths = []
acceptance = "Implement bounded confidential and sender-authenticated HPKE notification envelopes with authenticated metadata and downgrade refusal. Device wake payloads contain only opaque identifiers; replay, wrong recipients and expired keys cannot open application content or initiate operations."
remaining = "No sealed push envelope or notification consumer is present in the new foundation components."

[req.coverage.logging]
status = "pending"
tasks = ["task.3.2", "task.4.2"]
current_paths = ["crates/hm-core/src/telemetry.rs"]
acceptance = "Encode and parse canonical bounded log records with hierarchical severity filters and control-character handling. Redact secret-bearing fields before persistence or transport, retain append-only daily segments and rotate one writer. Resumed viewers receive an explicit gap when history expired."
remaining = "Tracing exists; canonical segmented logging and end-to-end secret-safe log UI are pending."

[req.coverage.registry]
status = "pending"
tasks = ["task.3.2", "task.4.2", "task.4.3"]
current_paths = ["crates/hm-fabric/src/routing.rs"]
acceptance = "Review capability changes, verify signed immutable release metadata and artifact digests in bounded staging, then activate atomically with retained rollback material. Ownership receipts identify installed paths; uninstall only removes still-matching owned files after retain/export/purge selection."
remaining = "Runtime registration exists; signed artifact install/update/uninstall ownership workflow does not."

[req.coverage.service_manager]
status = "pending"
tasks = ["task.3.2", "task.4.3"]
current_paths = []
acceptance = "Provide per-user native daemon service definitions on supported platforms, preserving full child-drain time and restart-on-crash behavior. Return native refusal details and ownership receipts. Install and uninstall do not modify unrelated services or silently elevate privileges."
remaining = "Cross-platform service-manager installation and shutdown qualification remain pending."

[req.coverage.remote]
status = "pending"
tasks = ["task.3.2", "task.4.2", "task.4.3"]
current_paths = ["crates/hm-serve/src/grpc/tls.rs"]
acceptance = "Enroll named peers explicitly with mutual TLS, reviewed expiring grants and signed discovery. Try permitted direct routes before relays; relay grants are side-specific, one-use and expiring. Advertise only remotely allowed operations and intersect peer grants with local policy."
remaining = "Existing TLS server is not federated routing, device enrollment or relay qualification."

[req.coverage.mobile]
status = "integration_pending"
tasks = ["task.3.38", "task.3.2", "task.4.2"]
current_paths = ["crates/hm-context/src/mobile_journal.rs", "crates/hm-fabric/src/mobile_delivery.rs", "crates/hm-capi/src/mobile_journal.rs", "sdk/swift/Sources/HyperMind/MobileJournal.swift"]
acceptance = "Maintain an outbound encrypted mobile connection with a durable local mutation journal. Reconcile unsettled mutations before admitting another write after resume; preserve unknown outcomes. Native inspection is one-column with usable filters, persistent connection status and review actions."
remaining = "Native Rust and Swift Linux journal consumers passed actual encrypted peer interruption, reopen and receipt reconciliation. Production endpoint integration, Apple platforms, handset lifecycle, background wake and native inspection UI remain pending."

[req.coverage.sdk]
status = "integration_pending"
tasks = ["task.2.2", "task.3.23", "task.3.38", "task.3.47", "task.4.3"]
current_paths = ["sdk/python/hypermind/context.py", "sdk/typescript/packages/client/src/context.ts", "crates/hm-serve/src/embedded.rs", "sdk/go", "sdk/swift/Sources/HyperMind/HyperMindEngine.swift"]
acceptance = "Rust, Python, TypeScript, Go and Swift preserve version negotiation, frame bounds, event order, source digests, cursors, cancellations and typed effect uncertainty. Reconnect reauthenticates and invalidates old epochs. Shared vectors and real daemon restart journeys qualify each language independently."
remaining = "Selected Rust, Python, TypeScript, Go and Swift routes passed native continuity and supported restart journeys. Swift encrypted journal reconciliation is qualified on Linux. Full development/operational consumers, in-flight Swift cancellation, Apple platforms and complete language parity remain pending."

[req.coverage.host]
status = "pending"
tasks = ["task.2.2", "task.4.2", "task.4.3"]
current_paths = ["sdk/python/hypermind/context.py"]
acceptance = "An installed OSS Gideon adapter translates owner/project/workspace/session/model/credential identities without guessing, supervises negotiated local lifecycle and preserves native transcript authority. Every primary model turn binds, ingests, projects and serializes before dispatch. Full-host readiness requires every declared family."
remaining = "A typed host interface is present; no complete installed OSS Gideon native lifecycle consumer is qualified."

[req.coverage.ui]
requires_acceptance = ["req.deep.documentation_proposals", "req.deep.profile_review"]
status = "integration_pending"
tasks = ["task.4.2"]
current_paths = ["sdk/typescript/packages/console/src/context.ts", "sdk/typescript/packages/console/src/app.ts"]
acceptance = "Native inspection, settings and operations use existing navigation and component patterns. Revision conflicts preserve drafts; plans show scope, expiry and digest before apply; ordered progress ends in a durable receipt with unknown outcomes distinct from failure. Desktop/mobile keyboard, touch, screen-reader and reduced-motion journeys use real services."
remaining = "Focused console rendering does not prove complete native host, accessibility or mobile user paths."

[req.coverage.credentials]
status = "integration_pending"
tasks = ["task.2.2", "task.4.2"]
current_paths = ["crates/hm-ledger/src/credentials.rs", "sdk/typescript/packages/console/src/access.ts"]
acceptance = "Read surfaces expose credential names, scope, backend, presence, validation time and consumers only. Secret values are write-only opaque handles resolved at dispatch. Credential changes fence consumers; no credential canary reaches prompts, process arguments, logs, exports or evidence."
remaining = "Complete host credential binding and actual secret-containment user paths remain pending."

[req.coverage.egress]
status = "pending"
tasks = ["task.3.2", "task.4.3"]
current_paths = ["crates/hm-llm/src/admission.rs"]
acceptance = "Apply destination policy to original requests and resolved DNS, redirects and proxies, refusing mixed addresses, rebinding and metadata-network bypass before unauthorized connections. Git and tool network effects use the same policy and typed denial classification."
remaining = "Provider admission alone does not establish complete DNS/redirect/proxy and Git egress containment."

[req.coverage.conditions]
requires_acceptance = ["req.deep.deferred_notes"]
status = "pending"
tasks = ["task.3.1", "task.4.2"]
current_paths = ["crates/hm-context/src/notes.rs", "crates/hm-cortex/src/repograph.rs"]
acceptance = "Expose bounded declarative file existence/content/time and repository ancestry/tag predicates under authorized roots. Canonicalize and revalidate targets; use argument-vector execution, verify repository identity and bound output. Never execute a note expression as code."
remaining = "The fact predicate interpreter is implemented; file and Git condition producers are pending."

[req.coverage.cli]
status = "integration_pending"
tasks = ["task.4.2"]
current_paths = ["crates/hm-cli/src/lib.rs"]
acceptance = "Provide status, inspection, configuration, maintenance, lifecycle, conditions and export commands with structured output and stable exit classes. Noninteractive mutations require complete scoped inputs and plan preconditions; unknown effects are reported without implicit retry."
remaining = "Full command family parity and actual lifecycle service consumers remain pending."

[req.coverage.release]
status = "pending"
tasks = ["task.4.1", "task.4.3"]
current_paths = ["crates/hm-eval/src/lib.rs", "crates/hm-sim/tests"]
acceptance = "Pin source and workload digests and record real-path recall, temporal/citation correctness, compression fidelity, latency, prefix reuse, cost and recovery. Qualify required platforms, SDKs, crash, authorization and supply-chain journeys; unavailable measurements stay explicit and do not count as passes."
remaining = "Aggregate acceptance and reversible cutover have not passed; prior outstanding release gates remain outstanding."

