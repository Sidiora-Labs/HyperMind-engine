acceptance = "Optional compact cues are content-revision cached derivatives with exact expansion back to original knowledge. If a vision-capable provider uses a visual representation of budget-trimmed memory, bind image/cue provenance and generation, account modality cost and preserve a textual fallback. Missing vision support or unreadable cues are visible limitations, never evidence of successful recall."
remaining = "Foundational records and scheduler APIs do not implement the complete evidence-consuming worker and host review journey. Ledger publication, real bounded workers and visible consumer evidence are required."

[req.deep.cross_session_memory]
status = "pending"
