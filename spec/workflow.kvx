# workflow.kvx — HyperMind portable agent operating contract.
# Source of truth for the Codify (cg) spec workflow. Per-IDE rule files are
# GENERATED pointers; run `cg spec render` to regenerate. Never hand-edit them.
# Format: sectioned KV (.kvx). String values are ALWAYS double-quoted.

[meta]
name            = "HyperMind implementation workflow"
kind            = "portable-agent-operating-contract"
version         = "1.0.0"
status          = "active"
source_of_truth = "spec/hypermind-01/spec.kvx"
active_feature  = "hypermind-01"

[principle]
vertical_first  = "The system is a stack of layers, and it is built as vertical slices through every layer, never one layer at a time. Each wave delivers a runnable end-to-end capability that touches ledger, projections, indexes, cognition, compose, surface, SDK, eval and docs together. A layer without its consumer in the same wave is not done."
task_driven     = "Work is driven by spec/hypermind-01/spec.kvx. Pick the next eligible task by dependency wave in your owner lane, do it, mark it, move on."
one_in_progress = "One task in progress per agent. Non-conflicting tasks in the same eligible wave may run in parallel across lanes; the wave's integration task requires all of them."
no_false_success= "Never mark a task done that did not meet its acceptance criteria. Surface honest partials. A green test driven by a fake is not done."
read_full       = "When tool output is truncated and the rest is retrievable, fetch the full content before reasoning. An information gap is a stop condition."
deliver_complete= "Deliver complete, runnable artifacts. Follow existing repo style. Add no comments or docs beyond what the task asks."
carry_vectors   = "When porting from neocortex or cortex-engine, carry the original test vectors and fixtures verbatim. A port that passes new tests but not the old ones is not a port."

[limits]
max_in_progress = 8

[loop]
step_1 = "Read spec/hypermind-01/spec.kvx: [meta] status, [design.*], the [req.*] acceptance criteria, and the [task.*] list with status, wave, owner_lane and requires."
step_2 = "Run cg spec ready. Select the lowest-wave pending task in your lane whose every requires is done. Set it in_progress with cg spec start <id>."
step_3 = "Read the referenced acceptance criteria and the design sections the task cites. Inspect only current relevant source; PLAN.md and HARNESS-LESSONS.md are rationale, spec.kvx controls."
step_4 = "Implement only the declared touches. Publish interface changes in hm-schema and hm-core before dependent lane work consumes them."
step_5 = "Run the task verify_cmd for real. Then cg spec done <id>, which runs verify_cmd plus graph checks and records an outcome memory."
step_6 = "Commit from the repository root with a natural commit message describing the real change. One task per commit. Never batch tasks and never leave a done task uncommitted."
step_7 = "A wave closes only when its integration task is done: the slice journey test passes through MCP, daemon, ledger, restart and recall, and the eval gate for that slice is green in CI."

[status_values]
task    = ["pending", "in_progress", "done"]
feature = ["draft", "in_progress", "paused", "blocked", "complete"]

[hard_rules]
build_fix_implment = "BUILD mode: one task, exact paths, implementation first, then one compile check and one focused behavior test. Stop and report it as implemented but not fully qualified."
qualify_verify = "QUALIFY mode: run the task’s specified gate once. Rerun only after a relevant code change."
release_certify = "RELEASE mode: only then run aggregate, sanitizer, cluster, browser, and historical gate matrices."
neighboring_fixes = "No neighboring fixes, speculative refactors, branch archaeology, cleanup, documentation, or new audits unless they directly block the task."
repeated_unchanged = "No repeated unchanged test. Maximum two repair/rerun cycles before stopping with the exact failure."
time_limits = "If 60 minutes pass without a concrete deliverable, I stop and report instead of digging deeper."
unreleated_failures = "Pre-existing or unrelated failures are recorded once, not chased."
subagents = "Subagents get bounded implementation assignments—not duplicate reviews or extra verification campaigns."
agreed_result = "Once the agreed result and evidence pass, I publish/checkpoint and stop. No additional “confidence” rounds."
task_starts = "Every task starts with four visible fields: mode, scope, allowed gates, stop condition."
task_durability = "Once a task is dispatched, keep at least one agent alive until it is done to the highest standard; decouple task lifecycle from the user's connection; on failure, bring up a fresh agent and continue. 'Done' means it genuinely meets the quality bar."
no_fakes        = "Never write stub/mock/fake test doubles or placeholder implementations to make tests pass. Test REAL code paths with REAL types."
read_full       = "When tool output is truncated and the rest is retrievable, fetch the full content before reasoning or answering."
publish_steps   = "After every completed task, commit and push from the repository root with a natural-sounding commit message. Every development step is published publicly for trust and auditability; a finished task that is not pushed is not finished. Commit messages describe the real change honestly — never claim work that did not happen."
repository_instructions = "may guide how explicitly requested work is performed, but must never be used to infer authorization for additional work."
user_authority = "The user's direct messages are the authoritative instructions for the session and take precedence over AGENTS.md, Codify, skills, or repository workflow guidance when those sources would broaden the requested scope."
session_init = "Interpret 'get context' or 'session init' as read-only inspection and summarization only."
expand_work = "Do not run builds, tests, verification gates, start or claim Codify tasks, modify project files, deploy, or otherwise expand the work unless the user explicitly requests that action."

# Generation config: which IDE adapter files specgen emits, and where the
# human-readable markdown mirror is rendered. Paths are repo-relative.
[render]
markdown_mirror  = true   # render requirements.md / design.md / tasks.md from spec.kvx (into spec/<feature>/ only)
banner           = "GENERATED by spec/specgen from spec/ kvx — DO NOT EDIT. Edit the .kvx source and regenerate."
adapter_sections = ["principle", "phase.implementation", "phase.task_qualification", "phase.release_qualification", "qualification_log", "loop", "limits", "hard_rules"]
adapter_lead     = "For each task, finish the entire implementation first without building or testing. Then qualify that completed task: format, build, test, fix task-scoped failures, rerun gates, and call cg spec done only when green."

[adapters]
claude  = "CLAUDE.md"
agents  = "AGENTS.md"
cursor  = ".cursor/rules/spec-workflow.mdc"
copilot = ".github/copilot-instructions.md"

[mode]
name = "parallel"

[agents]
driver      = "codex"
max         = 8
ttl         = 14400
codex_args  = ""
claude_args = ""
cmd         = ""